---
/*
 * Selected work, groups 1 and 2 — one project: its diagram paired with its text.
 * content.md §Selected work; design-system.md §4, §7, §9.
 *
 * Below 640px the diagram and the summary are both dropped (§7), leaving
 * category, title, role, outcome and tags — the mobile reduction described in
 * visual-direction.md §Responsive intent.
 */
import type { ProjectEntry } from '../../types/content';
import EmrDiagram from './diagrams/EmrDiagram.astro';
import DesignSystemDiagram from './diagrams/DesignSystemDiagram.astro';

interface Props {
  entry: ProjectEntry;
}

const { entry } = Astro.props;
const { visual, action } = entry;

/* The data names a diagram; the mapping keeps that name a closed set. */
const diagrams = {
  emr: EmrDiagram,
  'design-system': DesignSystemDiagram,
};
const Diagram = visual.kind === 'diagram' ? diagrams[visual.component] : null;
---

<li class:list={['project', { 'project--without-visual': visual.kind === 'none' }]}>
  {
    visual.kind !== 'none' && (
      <figure class="project__figure">
        {/*
         * A diagram is drawn in CSS and is decorative, so its accessible text
         * is the caption alone; an image is real content and carries its own
         * meaningful alt.
         */}
        {visual.kind === 'image' ? (
          <img
            class="project__image"
            src={visual.src}
            alt={visual.alt}
            width={visual.width}
            height={visual.height}
            loading="lazy"
            decoding="async"
          />
        ) : (
          Diagram && <Diagram />
        )}
        {visual.caption && <figcaption class="project__caption">{visual.caption}</figcaption>}
      </figure>
    )
  }

  <div class="project__body">
    <div class="project__head">
      <p class="project__category">{entry.category}</p>
      <h3 class="project__title">{entry.title}</h3>
      <p class="project__summary">{entry.summary}</p>
    </div>

    {/* §9 metadata <dl>: auto-fit columns over a 1px top rule. */}
    <dl class="project__meta">
      <div>
        <dt>Role</dt>
        <dd>{entry.role}</dd>
      </div>
      <div>
        <dt>Outcome</dt>
        <dd>{entry.outcome}</dd>
      </div>
    </dl>

    {/* An optional action sits below the tags, aligned with the project copy. */}
    <div class="project__footer">
      {/* §9 tags: plain text, no borders, fills or pills. */}
      <ul class="project__tags" aria-label="Tags">
        {entry.tags.map((tag) => <li>{tag}</li>)}
      </ul>

      {
        /*
         * The one action, rendered only when it is real: a link with a working
         * href, or a button with a working behaviour. There is no placeholder
         * form — no href="#", no invented route and no inert button.
         */
        action &&
          (action.kind === 'link' ? (
            <a class="project__action" href={action.href}>
              {action.label} <span aria-hidden="true">{action.href.startsWith('/') ? '→' : '↗'}</span>
            </a>
          ) : (
            <button class="project__action" type="button" data-behaviour={action.behaviour}>
              {action.label} <span aria-hidden="true">→</span>
            </button>
          ))
      }
    </div>
  </div>
</li>

<style>
  /*
   * §9 — the 1px divider is the only structural line; there are no cards. The
   * first project needs none, because the section already carries a top rule.
   */
  .project {
    padding-block: 0 var(--work-row-gap);
  }

  .project:not(:first-child) {
    border-top: var(--hairline);
    padding-block-start: var(--work-row-gap);
  }

  /*
   * The last row needs no trailing gap: the band that follows brings the
   * section's own --section-y padding plus its change of ground.
   */
  .project:last-child {
    padding-block-end: 0;
  }

  .project__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
  }

  .project__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .project__category {
    font-size: var(--fs-x-small);
    font-weight: var(--fw-semibold);
    line-height: 1.4;
    color: var(--accent);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* §4 — project title, the only use of 24px on the page. */
  .project__title {
    color: var(--text-strong);
    font-size: var(--fs-project-title);
    font-weight: var(--fw-semibold);
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  /* §4 — body 16. §7 — hidden below 640px together with the diagram. */
  .project__summary {
    display: none;
    font-size: var(--fs-body);
    line-height: 1.65;
  }

  /* §7 — diagrams are tablet and desktop only. */
  .project__figure {
    display: none;
  }

  /* An image visual fills the figure column and keeps the diagram's frame
     radius (§8), so either variant sits the same way in the row. */
  .project__image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-frame);
  }

  .project__caption {
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--text-muted);
  }

  .project__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-16) var(--space-28);
    border-top: var(--hairline);
    padding-top: 18px;
  }

  .project__meta dt {
    margin-bottom: var(--space-6);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    line-height: 1.4;
    color: var(--text-muted);
  }

  .project__meta dd {
    font-size: var(--fs-body-small);
    line-height: 1.55;
  }

  .project__footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-20);
  }

  .project__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6) var(--space-10);
    font-size: var(--fs-x-small);
    line-height: 1.4;
    color: var(--text-muted);
  }

  .project__tags li {
    background: rgba(255,255,255, 0.05);
    padding: 3px 6px;
    border-radius: 4px;
    white-space: nowrap;
  }

  /*
   * §9 content link: 15px/600 accent, no underline, aria-hidden trailing glyph,
   * 44px minimum target. One rule covers both action elements, so a link and a
   * button are the same control to look at; the button resets the UA's own
   * background, border and font. Focus comes from the global :focus-visible in
   * base.css (§10) and is never overridden here.
   */
  .project__action {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-6);
    min-height: 44px;
    padding: 0;
    background: none;
    border: 0;
    font-family: inherit;
    font-size: var(--fs-body-small);
    font-weight: var(--fw-semibold);
    line-height: 1.4;
    color: var(--accent);
    text-align: left;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  button.project__action {
    cursor: pointer;
  }

  .project__action:hover {
    color: var(--text);
  }

  /*
   * §7 tablet and up — the diagram sits beside its text. A two-column grid
   * rather than wrapped flex, so the pairing holds across the whole 640–1023px
   * range instead of collapsing again at the narrow end.
   */
  @media (min-width: 640px) {
    .project {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      gap: var(--space-32) clamp(28px, 4vw, 56px);
      align-items: start;
    }

    .project--without-visual {
      grid-template-columns: minmax(0, 1fr);
    }

    .project__summary {
      display: block;
    }

    .project__figure {
      display: flex;
      flex-direction: column;
      gap: var(--space-10);
    }
  }
</style>
