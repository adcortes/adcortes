---
/*
 * Skill peaks — the chart behind the illustrated hero.
 *
 * This is public/themes/earth/hero-skill-peaks.svg rebuilt in HTML and CSS.
 * The geometry is ported verbatim (src/data/hero.ts), so the drawing is the
 * approved one; what changes is what the browser can do with it:
 *
 *   - every bar animates on its own, from its own base, with a delay taken
 *     from its own x position, so the range grows left to right;
 *   - the five colour literals the SVG carried become --line, --accent,
 *     --text-muted and --bg, so the chart re-skins with the rest of the page
 *     (AGENTS.md: no colour literals outside tokens.css);
 *   - the labels are live text: they sit in a real list, scale with the
 *     container, and respond to a larger default font size instead of being
 *     frozen into a viewBox.
 *
 * Structure follows what each part means. The unlabelled ridge carries no
 * information and is hidden; the seven named peaks are a list, because that
 * is what a screen reader should get — seven names, once.
 *
 * `container-type: inline-size` makes every horizontal offset expressible in
 * cqw, so the composition scales as one piece at any width.
 */
import { skillPeaks, skillRidge } from '../../data/hero';

interface Props {
  /** Accessible name for the list of labelled peaks. */
  label?: string;
}

const { label = 'Things I work with' } = Astro.props;
---

<div class="peaks">
  {/* Decorative: no names, no meaning beyond the silhouette. */}
  <div class="peaks__ridge" aria-hidden="true">
    {
      skillRidge.map(([x, h]) => (
        <span class="peaks__bar" style={`--x:${x};--h:${h}`} />
      ))
    }
  </div>

  <ul class="peaks__list" aria-label={label}>
    {
      skillPeaks.map((peak) => (
        <li
          class:list={['peaks__peak', { 'peaks__peak--crest': peak.crest }]}
          style={`--x:${peak.x};--h:${peak.height}`}
        >
          <span class="peaks__stem" aria-hidden="true" />
          <span class="peaks__dot" aria-hidden="true" />
          <span class:list={['peaks__label', `peaks__label--${peak.align}`]}>{peak.label}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  /*
   * The box is the SVG's viewBox: 612 x 584, bars standing on its floor.
   * aspect-ratio holds that shape at any width, which is also what reserves
   * the composition's height before anything inside it paints.
   */
  .peaks {
    container-type: inline-size;
    position: relative;
    aspect-ratio: 662 / 624;
  }

  .peaks__ridge,
  .peaks__list {
    position: absolute;
    inset: 0;
  }

  /*
   * Every bar and peak is positioned from the same two numbers: --x is its
   * centre as a percentage of the width, --h its length as a percentage of
   * the height. Both arrive unitless so --x can also drive the delay.
   */
  .peaks__bar,
  .peaks__peak {
    position: absolute;
    bottom: 0;
    left: calc(var(--x) * 1%);
  }

  .peaks__bar,
  .peaks__stem {
    display: block;
    height: calc(var(--h) * 1%);
    /* Centred on --x: the bar is drawn around its own line, not beside it. */
    transform: translateX(-50%);
    /* The bar grows from its base, so the origin is the floor it stands on. */
    transform-origin: bottom center;
  }

  .peaks__bar {
    width: 1.5px;
    background: var(--line);
  }

  /*
   * A zero-width column the full height of the box: stem, marker and label
   * all hang off its centre line. It needs the height — that is what every
   * child's --h percentage is measured against.
   */
  .peaks__peak {
    top: 0;
    width: 0;
  }

  .peaks__stem {
    position: absolute;
    bottom: 0;
    width: 2px;
    background: var(--accent);
  }

  /*
   * The marker: a 10-unit ring straddling the top of its stem, filled with
   * the page ground so the stem never shows through it.
   */
  .peaks__dot {
    --dot: clamp(7px, 1.63cqw, 10px);
    position: absolute;
    bottom: calc(var(--h) * 1% - var(--dot) / 2);
    left: calc(var(--dot) / -2);
    width: var(--dot);
    height: var(--dot);
    border: 2px solid var(--accent);
    border-radius: 50%;
    background: var(--bg);
  }

  /* The crest is the one filled marker — the top of the range. */
  .peaks__peak--crest .peaks__dot {
    background: var(--accent);
  }

  /*
   * Labels sit a short gap above their marker. The size is proportional to
   * the composition (cqw) between a floor that stays legible on a phone and
   * a ceiling in rem, so a larger default font size still enlarges them.
   */
  .peaks__label {
    position: absolute;
    bottom: calc(var(--h) * 1% + clamp(10px, 2.3cqw, 14px));
    font-size: clamp(10px, 1.96cqw, 0.75rem);
    font-weight: var(--fw-semibold);
    line-height: 1;
    letter-spacing: 0.08em;
    white-space: nowrap;
    color: var(--text-muted);
  }

  .peaks__peak--crest .peaks__label {
    color: var(--accent-on-band);
  }

  .peaks__label--center {
    left: 0;
    transform: translateX(-50%);
  }

  /*
   * The longest label is right-aligned, ending just past its own stem, so it
   * stays inside the box instead of running off the left edge. 1.47cqw is the
   * SVG's 9-unit overhang.
   */
  .peaks__label--end {
    left: 1.47cqw;
    transform: translateX(-100%);
  }

  /*
   * --- Entrance -----------------------------------------------------------
   * The base state is the finished state: nothing here is hidden in CSS, and
   * every animation runs `backwards` from an offset. Turn the animations off
   * — reduced motion, an old browser — and the composition is simply there.
   *
   * Each element takes its delay from its own --x, so the range grows left to
   * right without needing an index, and a bar's marker and label follow once
   * that bar has finished. --peaks-delay is set by the parent to place the
   * whole chart in the hero's sequence.
   */
  .peaks__bar,
  .peaks__stem {
    animation: peak-grow 560ms cubic-bezier(0.25, 0.8, 0.4, 1) backwards;
    animation-delay: calc(var(--peaks-delay, 0ms) + var(--x) * 6ms);
  }

  .peaks__dot {
    animation: peak-mark 320ms cubic-bezier(0.25, 0.8, 0.4, 1) backwards;
    animation-delay: calc(var(--peaks-delay, 0ms) + var(--x) * 6ms + 420ms);
  }

  .peaks__label {
    animation: peak-label 420ms ease-out backwards;
    animation-delay: calc(var(--peaks-delay, 0ms) + var(--x) * 6ms + 480ms);
  }

  @keyframes peak-grow {
    from {
      transform: translateX(-50%) scaleY(0);
    }
  }

  @keyframes peak-mark {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
  }

  @keyframes peak-label {
    from {
      opacity: 0;
      /* A few pixels, not a slide: the label settles onto its marker. */
      translate: 0 4px;
    }
  }

  /* §11 — no entrance, no exception: the finished state, immediately. */
  @media (prefers-reduced-motion: reduce) {
    .peaks__bar,
    .peaks__stem,
    .peaks__dot,
    .peaks__label {
      animation: none;
    }
  }
</style>
