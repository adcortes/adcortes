---
/*
 * The one route.
 *
 * MILESTONE 3 — Selected work. The page order, landmarks and section labelling
 * are final; the remaining section bodies are filled in by later milestones:
 *   M4  Collaborations band, About, Contact
 *
 * Page order is fixed at every size (visual-direction.md §Page order):
 * Header, Hero, Selected work, Collaborations band, About, Contact, Footer.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionShell from '../components/SectionShell.astro';
import HeroBackground from '../components/HeroBackground.astro';
import ProjectEntry from '../components/work/ProjectEntry.astro';
import WebWorkGroup from '../components/work/WebWorkGroup.astro';
import { projects, webWork, workSection } from '../data/work';
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-h">
    {/* Decorative, first in the DOM so every text node paints over it. */}
    <HeroBackground />

    <div class="hero__content">
      <div class="hero__lead">
        <p class="hero__eyebrow">UX Engineer — design systems &amp; accessible frontend</p>
        <h1 id="hero-h" class="hero__title">Clear paths from idea to interface.</h1>
        <p class="hero__subline">Clear interfaces, built in code.</p>
      </div>

      <div class="hero__aside">
        <p class="hero__intro">
          UX Engineer working across product thinking, design systems and accessible frontend.
        </p>
        <p class="hero__jump">
          <a class="hero__link" href="#work">
            View selected work <span aria-hidden="true">↓</span>
          </a>
        </p>
      </div>
    </div>
  </section>

  <SectionShell id="work" labelledBy="work-h" topRule>
    <h2 slot="label" id="work-h" class="section-heading">{workSection.heading}</h2>
    <p slot="label" class="work__intro">
      {workSection.intro}
      {/* §7 — the diagram sentence only applies where the diagrams render. */}
      <span class="work__intro-extra"> {workSection.introFromTablet}</span>
    </p>

    <ol class="work__list">
      {projects.map((entry) => <ProjectEntry entry={entry} />)}
      <WebWorkGroup group={webWork} />
    </ol>
  </SectionShell>

  {/* M4: the full-bleed Selected collaborations band sits here. */}

  <SectionShell id="about" labelledBy="about-h">
    <h2 slot="label" id="about-h" class="section-heading">About</h2>
    {/* M4: About lead and the four numbered items. */}
  </SectionShell>

  <SectionShell id="contact" labelledBy="contact-h" topRule>
    <p slot="label" class="section-label">Contact</p>
    <h2 id="contact-h" class="contact-heading">Let's talk about what you're building.</h2>
    {/* M4: body copy and the single CTA. */}
  </SectionShell>
</BaseLayout>

<style>
  /* §5 — hero padding. `isolation` keeps the decorative background's z-index 0
     scoped to the hero, so it can never rise above anything else on the page. */
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: var(--hero-pad-top) var(--hero-pad-bottom);
  }

  /* Every text node sits on layer 1; the mountains and moon are on layer 0. */
  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  /* §1 — muted, under 16px, never a heading. */
  .hero__eyebrow {
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--paper-400);
    margin-bottom: var(--space-12);
  }

  /* §4 — Display, used once per page. Measure 17ch. */
  .hero__title {
    max-width: 17ch;
    font-size: var(--fs-display);
    font-weight: var(--fw-semibold);
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  /* §4 — Hero sub-line: the one accent string in the hero, kept short. */
  .hero__subline {
    margin-top: var(--space-20);
    font-size: var(--fs-sub);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--accent);
  }

  /* §4 — Body large, measure 460px. */
  .hero__intro {
    max-width: 460px;
    font-size: var(--fs-body-large);
    line-height: 1.65;
  }

  .hero__jump {
    margin-top: var(--space-20);
  }

  /*
   * §9 content link, hero variant: 15px/600 accent, no underline, a 1px bottom
   * border in the current colour and an aria-hidden trailing glyph. The 44px
   * minimum target comes from min-height, which also sets the border far enough
   * below the text to read as a rule rather than an underline.
   */
  .hero__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    min-height: var(--target-min);
    font-size: var(--fs-body-small);
    font-weight: var(--fw-semibold);
    line-height: 1.4;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  .hero__link:hover {
    color: var(--paper-200);
  }

  /*
   * §7 desktop — from 1024px the intro and its jump link move beside the
   * headline, matching the section grid's breakpoint. The two columns are
   * bottom-aligned, so the jump link sits on the sub-line's row exactly as the
   * approved desktop board shows. Below 1024px everything stays in one column,
   * as the tablet and mobile boards show.
   */
  @media (min-width: 1024px) {
    .hero__content {
      flex-direction: row;
      align-items: flex-end;
      gap: var(--column-gap);
    }

    .hero__lead {
      flex: 1 1 auto;
    }

    .hero__aside {
      flex: 0 1 460px;
    }
  }

  /* §4 — Section heading: 22px, deliberately small. */
  .section-heading {
    font-size: var(--fs-section);
    font-weight: var(--fw-semibold);
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  /*
   * §4 — body small, muted: the one line under the Work heading. On mobile only
   * its first sentence shows, because the diagrams it refers to are hidden (§7).
   */
  .work__intro {
    margin-top: var(--space-10);
    font-size: var(--fs-body-small);
    line-height: 1.5;
    color: var(--paper-400);
  }

  .work__intro-extra {
    display: none;
  }

  @media (min-width: 640px) {
    .work__intro-extra {
      display: inline;
    }
  }

  /* The three Selected work rows. Dividers and spacing belong to each row. */
  .work__list {
    display: flex;
    flex-direction: column;
  }

  /* Contact's label column is plain text; its h2 is the fluid closing statement. */
  .section-label {
    font-size: var(--fs-section);
    font-weight: var(--fw-semibold);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--paper-200);
  }

  /* §4 — Contact heading, fluid. Measure 52ch on the body copy that follows. */
  .contact-heading {
    font-size: var(--fs-contact);
    font-weight: var(--fw-semibold);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
</style>
