---
import BaseLayout from '../layouts/BaseLayout.astro';
import { notFound } from '../data/notFound';
---

<BaseLayout title={notFound.title} description={notFound.supportingText} noindex>
  <section class="not-found" aria-labelledby="not-found-heading">
    <div class="not-found__content">
      <h1 id="not-found-heading">
        <span class="not-found__code">
          <span class="not-found__sr-only">{notFound.code}</span>
          <img src="/images/404/404-with-branches.webp" width="1270" height="669" alt="" />
        </span>
        <span class="not-found__message">{notFound.message}</span>
      </h1>
      <p class="not-found__supporting">{notFound.supportingText}</p>
      <a class="not-found__home" href="/">{notFound.homeLabel}</a>
    </div>
    <img
      class="not-found__illustration"
      src="/images/404/404-illustration.webp"
      width="1567"
      height="992"
      alt=""
    />
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    width: 100%;
    padding-block: 42px;
  }

  .not-found__content {
    grid-area: 1 / 1;
    position: relative;
    z-index: 1;
    width: min(57%, 760px);
  }

  h1 {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-32);
  }

  .not-found__code {
    display: block;
    width: min(100%, 300px);
  }

  .not-found__code img {
    width: 100%;
    height: auto;
  }

  .not-found__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .not-found__message {
    font-size: clamp(40px, 2.6vw, 42px);
    letter-spacing: -0.042em;
    line-height: 1.08;
  }

  .not-found__supporting {
    margin-top: var(--space-16);
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--text-muted);
  }

  .not-found__home {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    margin-top: var(--space-40);
    padding-inline: var(--space-32);
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--bg);
    font-size: var(--fs-body-large);
    font-weight: var(--fw-semibold);
    line-height: 1;
    text-decoration: none;
  }

  .not-found__home:hover {
    background: var(--accent-hover, var(--accent));
  }

  .not-found__home:focus-visible {
    outline-color: var(--text);
  }

  .not-found__illustration {
    grid-area: 1 / 1;
    justify-self: end;
    width: min(48vw, 680px);
    height: auto;
    margin-top: 120px;
  }

  @media (max-width: 948px) {
    .not-found__illustration {
      width: 66vw;
      margin-top: 180px;
    }
    .not-found__content {
      max-width: 420px;
    }
  }
  @media (max-width: 769px) {
    .not-found__content {
      grid-area: auto;
      width: min(100%, 760px);
    }

    .not-found__illustration {
      grid-area: auto;
      justify-self: center;
      width: min(100%, 760px);
      margin: -60px auto 0;
    }
  }

  @media (max-width: 639px) {
    h1 {
      gap: var(--space-24);
    }

    .not-found__message {
      font-size: clamp(32px, 8vw, 44px);
    }

    .not-found__home {
      margin-top: var(--space-32);
    }
  }
  @media (max-width: 550px) {
    .not-found__illustration {
      margin-top: -20px;
    }
  }

</style>
