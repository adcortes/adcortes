---
/*
 * The one route.
 *
 * Page order is fixed at every size: Header, Hero, Selected work, Earlier web
 * projects band, About, Contact, Footer.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionShell from '../components/SectionShell.astro';
import Hero from '../components/hero/Hero.astro';
import ProjectEntry from '../components/work/ProjectEntry.astro';
import WebWorkGroup from '../components/work/WebWorkGroup.astro';
import AboutList from '../components/AboutList.astro';
import { projects, webWork, workSection } from '../data/work';
import { about, aboutItems } from '../data/about';
import { contact } from '../data/site';
import { mailtoHref } from '../lib/email';
---

<BaseLayout>
  <Hero />

  <SectionShell id="work" labelledBy="work-h">
    <h2 slot="label" id="work-h" class="section-heading">{workSection.heading}</h2>
    <p slot="label" class="work__intro">
      {workSection.intro}
    </p>

    <ol class="work__list">
      {projects.map((entry) => <ProjectEntry entry={entry} />)}
    </ol>
  </SectionShell>

  {/*
    The full-bleed band, a direct child of `main.container` so it can break out
    of the cap — see WebWorkGroup.astro. It stays between Selected work and
    About, which is where the page order puts it.
  */}
  <WebWorkGroup group={webWork} />

  <SectionShell id="about" labelledBy="about-h">
    <h2 slot="label" id="about-h" class="section-heading">{about.heading}</h2>

    <p class="about__lead">{about.lead}</p>
    <AboutList items={aboutItems} />
  </SectionShell>

  <SectionShell id="contact" labelledBy="contact-h" topRule closing>
    <p slot="label" class="section-label">{contact.label}</p>

    <h2 id="contact-h" class="contact-heading">{contact.heading}</h2>
    <p class="contact__body">{contact.body}</p>
    {/* This navigates to the assembled contact address, which is not printed in the HTML source. */}
    <p class="contact__action">
      <a class="cta" href={mailtoHref()}>
        {contact.ctaLabel} <span aria-hidden="true">→</span>
      </a>
    </p>
  </SectionShell>
</BaseLayout>

<style>
  /* The section heading stays deliberately small. */
  .section-heading {
    font-size: var(--fs-section);
    font-weight: var(--fw-semibold);
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .work__intro {
    margin-top: var(--space-10);
    font-size: var(--fs-body-small);
    line-height: 1.5;
    color: var(--text-muted);
  }

  /* The three Selected work rows. Dividers and spacing belong to each row. */
  .work__list {
    display: flex;
    flex-direction: column;
  }

  /* The one reflective paragraph. Measure 44ch. */
  .about__lead {
    max-width: 44ch;
    font-size: var(--fs-lead);
    line-height: 1.55;
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  /* Contact's label column is plain text; its h2 is the fluid closing statement. */
  .section-label {
    font-size: var(--fs-section);
    font-weight: var(--fw-semibold);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--text);
  }

  /* Fluid. Measure 52ch on the body copy that follows. */
  .contact-heading {
    font-size: var(--fs-contact);
    font-weight: var(--fw-semibold);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  /* Measure 52ch. */
  .contact__body {
    max-width: 52ch;
    margin-top: var(--space-20);
  }

  .contact__action {
    margin-top: var(--space-32);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    min-height: var(--cta-height);
    padding-inline: 22px;
    border: 1px solid var(--accent);
    border-radius: var(--radius-cta);
    font-size: var(--fs-body);
    font-weight: var(--fw-semibold);
    line-height: 1;
    color: var(--accent);
    text-decoration: none;
  }

  .cta:hover {
    background: var(--accent);
    color: var(--bg);
  }
</style>
