---
/* The Animated Valley hero's copy and viewport layout, without its scenery. */
import { hero } from '../../data/hero';

const titleBreak = ' to interface.';
const titleFirstLine = hero.title.endsWith(titleBreak)
  ? hero.title.slice(0, -titleBreak.length)
  : hero.title;
const titleSecondLine = hero.title.endsWith(titleBreak) ? titleBreak.trimStart() : '';
---

<section class="hero" aria-labelledby="hero-h" data-clean-hero>
  <div class="hero__content">
    <p class="hero__eyebrow" data-clean-text>{hero.eyebrow}</p>
    <h1 id="hero-h" class="hero__title" data-clean-text>
      {titleFirstLine} {titleSecondLine}
    </h1>
    <p class="hero__subline" data-clean-text>{hero.subline.illustrated}</p>
    <p class="hero__intro" data-clean-text>{hero.intro}</p>
    <p class="hero__jump" data-clean-text>
      <a class="hero__link" href={hero.jumpHref}>
        {hero.jumpLabel} <span aria-hidden="true">↓</span>
      </a>
    </p>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { motion } from '../../lib/motion';

  const hero = document.querySelector<HTMLElement>('[data-clean-hero]');
  if (hero) {
    let entranceHandled = false;
    const media = gsap.matchMedia();
    media.add('(prefers-reduced-motion: no-preference)', () => {
      if (entranceHandled) return;
      entranceHandled = true;
      const root = document.documentElement;
      if (root.dataset.heroMotion !== 'ready' || hero.getBoundingClientRect().bottom <= 0) {
        delete root.dataset.heroMotion;
        return;
      }
      const text = hero.querySelectorAll<HTMLElement>('[data-clean-text]');
      const finish = () => {
        delete root.dataset.heroMotion;
        gsap.set(text, { clearProps: 'opacity,transform' });
      };
      const timeline = gsap.timeline({
        defaults: { ease: motion.ease },
        onComplete: finish,
      }).fromTo(
        text,
        { opacity: 0, y: motion.hero.clean.y },
        {
          opacity: 1,
          y: 0,
          duration: motion.hero.clean.duration,
          stagger: motion.hero.clean.stagger,
        },
        motion.hero.clean.start,
      );
      const onFocusIn = () => timeline.progress(1);
      hero.addEventListener('focusin', onFocusIn, { once: true });
      return () => {
        hero.removeEventListener('focusin', onFocusIn);
        timeline.kill();
        finish();
      };
    });
    document.addEventListener('astro:before-swap', () => media.revert(), { once: true });
  }
</script>

<style>
  :global(html[data-hero-motion='ready'] [data-clean-text]) {
    opacity: 0;
  }

  .hero {
    position: relative;
    isolation: isolate;
    min-height: calc(100vh - var(--header-height) - 1px);
    min-height: calc(100dvh - var(--header-height) - 1px);
    padding-block: clamp(56px, 4vw, 72px) var(--space-80);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    width: min(100%, 90%);
    margin-top: 12vh;
  }

  .hero__eyebrow {
    color: var(--text-muted);
    font-size: var(--fs-small);
    line-height: 1.4;
  }

  .hero__title {
    margin-top: var(--space-20);
    font-size: var(--fs-valley-title);
    font-weight: var(--fw-bold);
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  .hero__title span {
    display: block;
  }

  .hero__subline {
    margin-top: clamp(20px, 1vw, 32px);
    color: var(--accent);
    font-size: var(--fs-valley-subline);
    font-weight: var(--fw-bold);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .hero__intro {
    max-width: 680px;
    margin-top: var(--space-28);
    font-size: var(--fs-body-large);
    line-height: 1.65;
  }

  .hero__jump {
    margin-top: var(--space-28);
  }

  .hero__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    min-height: var(--cta-height);
    padding-inline: var(--space-24);
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--bg);
    font-size: var(--fs-body-small);
    font-weight: var(--fw-semibold);
    line-height: 1;
    text-decoration: none;
  }

  .hero__link:hover {
    background: var(--text);
  }

  .hero__link:focus-visible {
    outline-color: var(--text);
  }

  @media (max-width: 639px) {
    .hero {
      padding-block: var(--space-56) var(--space-80);
    }

    .hero__subline {
      max-width: 15ch;
    }
  }
</style>
