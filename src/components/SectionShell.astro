---
/*
 * The label-column / content-column pairing shared by Work, About and Contact.
 * design-system.md §6 (section grid), §7 (breakpoints).
 *
 * Below 1024px the label sits above the content; from 1024px it sits beside it.
 * This is a real media query — the prototype switched on window.innerWidth and
 * that behaviour is deliberately not reproduced.
 *
 * Two slots: `label` (the section heading, or plain label text for Contact) and
 * the default slot for the content column.
 */

interface Props {
  id: string;
  labelledBy: string;
  /** Sections after the hero carry a 1px top rule; About does not. */
  topRule?: boolean;
}

const { id, labelledBy, topRule = false } = Astro.props;
---

<section id={id} aria-labelledby={labelledBy} class:list={['section', { 'section--ruled': topRule }]}>
  <div class="section__label">
    <slot name="label" />
  </div>
  <div class="section__content">
    <slot />
  </div>
</section>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: var(--space-32) var(--column-gap);
    padding-block: var(--section-y);
  }

  .section--ruled {
    border-top: var(--hairline);
  }

  /* §6 — label column 1 1 200px capped at 280px, content column 3.4 1 620px. */
  @media (min-width: 1024px) {
    .section {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-start;
    }

    .section__label {
      flex: 1 1 200px;
      max-width: 280px;
    }

    .section__content {
      flex: 3.4 1 620px;
    }
  }
</style>
