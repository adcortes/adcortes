---
/*
 * Selected work, groups 1 and 2 — one project: its artwork paired with its text.
 *
 * Below 640px the artwork and the summary are both dropped, leaving category,
 * title, role, outcome and tags.
 */
import type { ArtworkId, ProjectEntry } from '../../types/content';
import AirlineStub from './artwork/AirlineStub.astro';
import AirlineFares from './artwork/AirlineFares.astro';

interface Props {
  entry: ProjectEntry;
}

const { entry } = Astro.props;
const { visual, action } = entry;

/*
 * The artwork registry. `satisfies` makes it total against ArtworkId without
 * widening it, so a key added to the type but never drawn — or a component
 * registered under a name the type does not allow — is a build error, and the
 * lookup below still infers the exact component.
 */
const artworks = {
  'airline-stub': AirlineStub,
  'airline-fares': AirlineFares,
} satisfies Record<ArtworkId, unknown>;

const Artwork = visual?.kind === 'artwork' ? artworks[visual.id] : null;
---

<li class:list={['project', { 'project--without-visual': !visual }]}>
  {
    visual && (
      <figure class="project__figure">
        {/*
         * An artwork is drawn in CSS and is decorative, so its accessible text
         * is the caption alone; an image is real content and carries its own
         * meaningful alt.
         */}
        {visual.kind === 'image' ? (
          <img
            class="project__image"
            src={visual.src}
            alt={visual.alt}
            width={visual.width}
            height={visual.height}
            loading="lazy"
            decoding="async"
          />
        ) : (
          Artwork && <Artwork />
        )}
        {visual.caption && <figcaption class="project__caption">{visual.caption}</figcaption>}
      </figure>
    )
  }

  <div class="project__body">
    <div class="project__head">
      <p class="project__category">{entry.category}</p>
      <h3 class="project__title">{entry.title}</h3>
      <p class="project__summary">{entry.summary}</p>
    </div>

    {/* Metadata <dl>: auto-fit columns over a 1px top rule. */}
    <dl class="project__meta">
      <div>
        <dt>Role</dt>
        <dd>{entry.role}</dd>
      </div>
      <div>
        <dt>Outcome</dt>
        <dd>{entry.outcome}</dd>
      </div>
    </dl>

    {/* An optional action sits below the tags, aligned with the project copy. */}
    <div class="project__footer">
      {/* Tags: plain text, no borders, fills or pills. */}
      <ul class="project__tags" aria-label="Tags">
        {entry.tags.map((tag) => <li>{tag}</li>)}
      </ul>

      {
        /*
         * The one action, rendered only when it is real: a link with a working
         * href, or a button with a working behaviour. There is no placeholder
         * form — no href="#", no invented route and no inert button.
         */
        action &&
          (action.kind === 'link' ? (
            <a class="project__action" href={action.href}>
              {action.label} <span aria-hidden="true">{action.href.startsWith('/') ? '→' : '↗'}</span>
            </a>
          ) : (
            <button class="project__action" type="button" data-behaviour={action.behaviour}>
              {action.label} <span aria-hidden="true">→</span>
            </button>
          ))
      }
    </div>
  </div>
</li>

<style>
  /*
   * The 1px divider is the only structural line; there are no cards. The
   * first project needs none, because the section already carries a top rule.
   */
  .project {
    padding-block: 0 var(--work-row-gap);
  }

  .project:not(:first-child) {
    border-top: var(--hairline);
    padding-block-start: var(--work-row-gap);
  }

  /*
   * The last row needs no trailing gap: the band that follows brings the
   * section's own --section-y padding plus its change of ground.
   */
  .project:last-child {
    padding-block-end: 0;
  }

  .project__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
  }

  .project__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .project__category {
    font-size: var(--fs-x-small);
    font-weight: var(--fw-semibold);
    line-height: 1.4;
    color: var(--accent);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* The project title, the only use of this size on the page. */
  .project__title {
    color: var(--text-strong);
    font-size: var(--fs-project-title);
    font-weight: var(--fw-semibold);
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  /* Hidden below 640px together with the artwork. */
  .project__summary {
    display: none;
    font-size: var(--fs-body);
    line-height: 1.65;
  }

  /* Artwork is tablet and desktop only. */
  .project__figure {
    display: none;
  }

  /* An image visual fills the figure column and keeps the same frame radius an
     artwork draws for itself, so either variant sits the same way in the row. */
  .project__image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-frame);
  }

  .project__caption {
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--text-muted);
  }

  .project__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-16) var(--space-28);
    border-top: var(--hairline);
    padding-top: 18px;
  }

  .project__meta dt {
    margin-bottom: var(--space-6);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    line-height: 1.4;
    color: var(--text-muted);
  }

  .project__meta dd {
    font-size: var(--fs-body-small);
    line-height: 1.55;
  }

  .project__footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-20);
  }

  .project__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6) var(--space-10);
    font-size: var(--fs-x-small);
    line-height: 1.4;
    color: var(--text-muted);
  }

  .project__tags li {
    background: rgba(255,255,255, 0.05);
    padding: 3px 6px;
    border-radius: 4px;
    white-space: nowrap;
  }

  /*
   * 44px minimum target. One rule covers both action elements, so a link and a
   * button are the same control to look at; the button resets the UA's own
   * background, border and font. Focus comes from the global :focus-visible in
   * base.css and is never overridden here.
   */
  .project__action {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-6);
    min-height: 44px;
    padding: 0;
    background: none;
    border: 0;
    font-family: inherit;
    font-size: var(--fs-body-small);
    font-weight: var(--fw-semibold);
    line-height: 1.4;
    color: var(--accent);
    text-align: left;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  button.project__action {
    cursor: pointer;
  }

  .project__action:hover {
    color: var(--text);
  }

  /*
   * Tablet and up — the artwork sits beside its text. A two-column grid
   * rather than wrapped flex, so the pairing holds across the whole 640–1023px
   * range instead of collapsing again at the narrow end.
   */
  @media (min-width: 640px) {
    .project {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      gap: var(--space-32) clamp(28px, 4vw, 56px);
      align-items: start;
    }

    .project--without-visual {
      grid-template-columns: minmax(0, 1fr);
    }

    .project__summary {
      display: block;
    }

    .project__figure {
      display: flex;
      flex-direction: column;
      gap: var(--space-10);
    }
  }
</style>
