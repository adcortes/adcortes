---
/*
 * Selected work, group 3 — the Earlier web projects archive.
 * Source of truth: handoff/earlier-web-projects.md (option 5b), content.md
 * §Selected work "3. Agency & freelance", design-system.md §4, §7.
 *
 * An archive table with inline disclosure: one row per project, each row a
 * button that opens its own details and screenshot in place. Only one row is
 * open at a time. It reads like a CV archive — scannable, honest about how each
 * piece was engaged — and the disclosure pattern works on touch, keyboard and
 * screen readers without depending on hover.
 *
 * The one full-bleed band on the page (§6: "bleeds to full width; its inner
 * content is capped at 1128px"), carrying the raised slate ground that marks
 * the break after the Selected work projects. It sits as a direct child of
 * `main.container`, so it breaks out with the documented negative-margin
 * trick: that containing block is centred, so `calc(50% - 50vw)` on each side
 * lands the edges exactly on the viewport edges, and `html { overflow-x: clip }`
 * in base.css already absorbs the scrollbar overhang. `--band-inner` then puts
 * the content back on the same grid as every capped section above it.
 *
 * Its heading keeps h3: the level the group had inside Selected work, and the
 * one the approved type scale draws. The region is named by it, which puts each
 * project's own heading at h4 — one level below the handoff's sketch, because
 * there the section stood alone.
 *
 * Progressive enhancement. The server renders every panel open and every button
 * `aria-expanded="true"`, so with no JavaScript the archive is a plain, fully
 * readable list. The inline script below sets `data-enhanced` on the section —
 * which is what arms the collapsing CSS — then closes every panel and opens the
 * first. It runs before first paint, so there is no flash of the open state.
 */
import type { WebWorkGroup } from '../../types/content';

interface Props {
  group: WebWorkGroup;
}

const { group } = Astro.props;
---

<section class="web" aria-labelledby="web-work-h" data-ewp>
  <div class="web__inner">
    <div class="web__head">
      <div class="web__heading">
        <p class="web__category">{group.category}</p>
        <h3 id="web-work-h" class="web__title">{group.title}</h3>
      </div>
      <p class="web__intro">{group.intro}</p>
    </div>

    {/*
      Visual only: each row repeats its own role and engagement inside its
      button, so a screen reader hears them in context and never needs these
      labels. Hidden below 640px, where the columns fold.

      The third column is deliberately unlabelled — "Agency" and "Freelance"
      name themselves — and the fourth holds the toggle. Both keep their empty
      span so the header row stays on the same four-column template as the rows.
    */}
    <div class="web__table">
      <div class="web__cols" aria-hidden="true">
        <span>Project</span>
        <span>Role</span>
        <span></span>
        <span></span>
      </div>

      <ul class="web__items">
        {
          group.items.map((item, i) => (
            <li class="web__item">
              <h4 class="web__row-heading">
                <button
                  type="button"
                  class="web__row"
                  id={`ewp-btn-${i}`}
                  aria-expanded="true"
                  aria-controls={`ewp-panel-${i}`}
                >
                  <span class="web__name">{item.name}</span>

                  {/*
                    `display: contents` from 640px up, so role and engagement
                    sit in their own table columns; below it the wrapper becomes
                    the one muted line that folds under the name.
                  */}
                  <span class="web__fold">
                    {item.role && <span class="web__role">{item.role}</span>}
                    {item.engagement && (
                      <span class="web__engagement">{item.engagement}</span>
                    )}
                  </span>

                  {/* Drawn with two CSS bars, not a glyph, so it stays crisp. */}
                  <span class="web__icon" aria-hidden="true" />
                </button>
              </h4>

              <div
                class="web__panel"
                id={`ewp-panel-${i}`}
                role="region"
                aria-labelledby={`ewp-btn-${i}`}
              >
                <div class="web__panel-inner">
                  <figure class="web__shot">
                    {item.image ? (
                      <img
                        src={item.image.src}
                        alt={item.image.alt}
                        width={item.image.width}
                        height={item.image.height}
                        loading="lazy"
                        decoding="async"
                        data-crop={item.image.crop ?? 'top'}
                      />
                    ) : (
                      /* The surface still holds its 16:10 box, so a row without
                        a screenshot opens to the same height as the others. */
                      <p class="web__shot-empty">Screenshot coming soon</p>
                    )}
                  </figure>

                  <div class="web__body">
                    <p class="web__description">{item.description}</p>

                    {/* An absent list and an empty one both render nothing. */}
                    {item.tags && item.tags.length > 0 && (
                      <ul class="web__tags" aria-label="Tags">
                        {item.tags.map((tag) => (
                          <li>{tag}</li>
                        ))}
                      </ul>
                    )}

                    {/*
                      Rendered only with a real destination; never href="#". The
                      label names the project, because three identical "Visit
                      site" links are ambiguous out of context; the visible text
                      opens it, so the accessible name still starts with what the
                      link says.
                    */}
                    {item.link && (
                      <a
                        class="web__link"
                        href={item.link.href}
                        target={item.link.target ?? '_self'}
                        aria-label={`${item.link.label} (opens ${item.name})`}
                      >
                        {item.link.label} <span aria-hidden="true">↗</span>
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /*
   * The band. The break after the Selected work projects is the change of
   * ground rather than a rule: it sits on --surface-raised, one step up from
   * the page's --bg, which also gives the screenshots a neutral slate to
   * sit on. No rule on either edge — a hairline and a surface change next to
   * each other read as two separate breaks — and no radius, since the band
   * meets both viewport edges. Its own --section-y padding carries the vertical
   * rhythm the capped sections take from the shell.
   *
   * Everything inside the band that would normally read --accent or
   * --text-muted uses the *-on-band variant instead: on Earth's raised
   * surface, plain --accent falls under WCAG AA (earth-theme/
   * color-adjustments.md's contrast table). Egg's on-band variants are
   * identical to the plain ones, so this costs it nothing.
   */
  .web {
    margin-inline: calc(50% - 50vw);
    background: var(--surface-raised);
    padding-block: var(--section-y);
    padding-inline: var(--gutter);
  }

  .web :focus-visible {
    outline-color: var(--accent-on-band);
  }

  /* §6 — the band bleeds, its content does not: the same 1128px reading grid. */
  .web__inner {
    max-width: var(--band-inner);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-28);
  }

  .web__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .web__heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  /* §4 — same category and title styles as the two projects above. */
  .web__category {
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    color: var(--accent-on-band);
  }

  .web__title {
    font-size: var(--fs-section);
    font-weight: var(--fw-semibold);
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .web__intro {
    font-size: var(--fs-body-small);
    line-height: 1.6;
  }

  /*
   * --- The table ------------------------------------------------------------
   * One shared column template for the header row and every project row, so the
   * two stay locked together at each size. Mobile drops to name + toggle and
   * folds role and engagement underneath.
   */
  .web__cols,
  .web__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 44px;
    gap: 0 var(--space-20);
    align-items: center;
  }

  /* Column labels are hidden where the columns they name no longer exist. */
  .web__cols {
    display: none;
    font-size: var(--fs-x-small);
    font-weight: var(--fw-semibold);
    line-height: 1.4;
    color: var(--text-muted-on-band);
    padding-bottom: var(--space-10);
  }

  .web__items {
    /* Closes the table: every row draws its own top rule. */
    border-bottom: var(--hairline-raised);
  }

  /* --hairline-raised, not --hairline: on this ground --line is 1.25:1. */
  .web__item {
    padding: 8px 0;
    border-top: var(--hairline-raised);
  }

  /* The heading is structure only; the button inside it carries the type. */
  .web__row-heading {
    font: inherit;
    margin: 0;
  }

  /* The whole row is the hit area, and it clears 44px on its own. */
  .web__row {
    width: 100%;
    min-height: 36px;
    /* padding: 14px 0; */
    margin: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  /* §4 — 17px/600, the same weight and size as an About item title. */
  .web__name {
    font-size: var(--fs-about-item);
    font-weight: var(--fw-semibold);
    line-height: 1.35;
    color: var(--text);
  }

  /* Hover and the open state share one accent treatment; nothing else moves. */
  .web__row:hover .web__name,
  .web__row[aria-expanded='true'] .web__name {
    color: var(--accent-on-band);
  }

  .web__role,
  .web__engagement {
    font-size: var(--fs-body-small);
    font-weight: var(--fw-regular);
    line-height: 1.4;
  }

  .web__engagement {
    color: var(--text-muted-on-band);
  }

  /*
   * Below 640px role and engagement fold under the name as one muted line,
   * "Web design · Frontend development · Agency", with a middot between them.
   * The wrapper is a real box only here.
   *
   * The line follows DOM order — role, then engagement — so nothing is
   * reordered in CSS: what a screen reader hears inside the button is what is
   * on screen, at this size and at every size above it (WCAG 1.3.2, meaningful
   * sequence).
   */
  .web__fold {
    grid-column: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-6);
    margin-top: var(--space-4);
    color: var(--text-muted-on-band);
  }

  .web__fold .web__role {
    color: inherit;
  }

  .web__fold .web__role + .web__engagement::before {
    content: '·';
    margin-right: var(--space-6);
  }

  /*
   * The toggle: a 28px ring with two bars. The vertical one rotates a quarter
   * turn onto the horizontal one when the row opens, so + becomes −.
   */
  .web__icon {
    position: relative;
    justify-self: end;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-light);
    color: var(--text);
  }

  .web__icon::before,
  .web__icon::after {
    content: '';
    position: absolute;
    inset: 50% 7px auto;
    height: 1px;
    margin-top: -0.5px;
    background: currentColor;
  }

  .web__icon::after {
    transform: rotate(90deg);
    transition: transform 150ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .web__row:hover .web__icon,
  .web__row[aria-expanded='true'] .web__icon {
    color: var(--accent-on-band);
  }

  /* Open: the vertical bar lies down on the horizontal one. */
  .web__row[aria-expanded='true'] .web__icon::after {
    transform: rotate(0deg);
  }

  /*
   * --- The panel ------------------------------------------------------------
   * Static by default, which is the no-JavaScript state: every panel is simply
   * open. `data-enhanced` — set by the script once it has taken over — is what
   * turns the panel into the collapsing 0fr/1fr grid.
   */
  .web__panel-inner {
    display: grid;
    gap: var(--space-20);
    /* padding: 4px 0 28px; */
    /* The row that collapses; it must be able to reach zero. */
    min-height: 0;
    overflow: hidden;
  }

  .web[data-enhanced] .web__panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 200ms cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 200ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .web[data-enhanced] .web__panel[data-open] {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  /*
   * The screenshot surface: one step up from the band, with the image sitting
   * on it inset left, right and top so it reads as a screen on a desk rather
   * than a bled-off photograph. 16:10, the ratio the exports are cropped to.
   */
  .web__shot {
    margin: 0;
    display: grid;
    background: var(--figure-bg-on-band);
    border-radius: var(--radius-panel);
    box-shadow: inset 0 0 0 1px var(--line-light);
    padding: 5% 5% 0;
  }

  .web__shot img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border-radius: 3px 3px 0 0;
  }

  .web__shot img[data-crop='center'] {
    object-position: center;
  }

  /* A row with no screenshot yet keeps the same box, so nothing jumps. */
  .web__shot-empty {
    aspect-ratio: 16 / 10;
    display: grid;
    place-content: center;
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--text-muted-on-band);
  }

  .web__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .web__description {
    max-width: 520px;
    font-size: var(--fs-body);
    line-height: 1.6;
    padding-top: var(--space-10);
    text-wrap: pretty;
  }

  /* §9 tags: plain text on a subtle chip, as in the projects above. */
  .web__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6) var(--space-8);
    margin-top: var(--space-12);
    font-size: var(--fs-x-small);
    line-height: 1.4;
    color: var(--text);
  }

  .web__tags li {
    background: var(--chip-raised);
    padding: 3px 8px;
    border-radius: var(--radius-chip);
    white-space: nowrap;
  }

  /*
   * §9 content link. 44px rather than the page's --target-min: the archive's
   * own acceptance check asks for 44px targets, and this link sits inside a
   * dense list where the extra room is worth having.
   */
  .web__link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-6);
    min-height: 44px;
    margin-top: var(--space-8);
    font-size: var(--fs-body-small);
    font-weight: var(--fw-semibold);
    line-height: 1.4;
    color: var(--accent-on-band);
    text-decoration: none;
  }

  .web__link:hover {
    color: var(--text);
  }

  /* §7 tablet and up — the intro moves beside the heading, the table opens. */
  @media (min-width: 640px) {
    .web__head {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: var(--space-12) clamp(28px, 4vw, 56px);
    }

    .web__heading {
      flex: 1 1 280px;
    }

    .web__intro {
      flex: 1.2 1 320px;
      max-width: 420px;
    }

    .web__cols,
    .web__row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 96px 44px;
      gap: 0 var(--space-20);
    }

    .web__cols {
      display: grid;
    }

    /* Role and engagement become table cells of their own. */
    .web__fold {
      display: contents;
    }

    /*
     * `display: contents` promotes role and engagement to grid items of the
     * row, so they auto-place in DOM order — name, role, engagement, toggle —
     * landing under the Project and Role labels and the unlabelled third
     * column, with no `order` and no explicit placement. That is what keeps the
     * visual columns and the button's reading order from ever drifting apart.
     */
    .web__fold .web__role {
      color: var(--text);
    }

    /* The middot belongs to the folded line only. */
    .web__fold .web__role + .web__engagement::before {
      content: none;
    }
    .web__description {
      padding-top: var(--space-10);
    }

    .web__panel-inner {
      grid-template-columns: 240px minmax(0, 1fr);
      gap: var(--space-28);
      /* padding: 6px 0 32px; */
    }
  }

  /* §7 desktop — the handoff's wider table and wider screenshot. */
  @media (min-width: 1024px) {
    .web__cols,
    .web__row {
      grid-template-columns: 2.4fr 4fr 120px 44px;
      gap: 0 var(--space-24);
    }

    .web__panel-inner {
      grid-template-columns: 320px minmax(0, 1fr);
      gap: var(--space-40);
    }
  }

  /* Panels open instantly; the icon still changes, it just does not swing. */
  @media (prefers-reduced-motion: reduce) {
    .web[data-enhanced] .web__panel,
    .web__icon::after {
      transition: none;
    }
  }
</style>

<script is:inline>
  /*
   * The archive's disclosure behaviour — the page's only script. It runs where
   * it sits, before first paint, so the open-by-default markup above is
   * collapsed without a flash.
   *
   * Closing animates first and only then sets `hidden`, so the panel keeps its
   * 200ms collapse while still leaving the accessibility tree and the tab order
   * once it is shut.
   */
  (() => {
    const root = document.querySelector('[data-ewp]');
    if (!root) return;

    const rows = Array.from(root.querySelectorAll('button[aria-controls]'))
      .map((btn) => ({ btn, panel: document.getElementById(btn.getAttribute('aria-controls')) }))
      .filter((row) => row.panel);
    if (!rows.length) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const isOpen = (row) => row.btn.getAttribute('aria-expanded') === 'true';

    const close = (row) => {
      row.btn.setAttribute('aria-expanded', 'false');
      delete row.panel.dataset.open;

      if (reduced.matches) {
        row.panel.hidden = true;
        return;
      }

      // Runs on transitionend, and again on a timer for any browser that
      // decides not to transition the grid row at all.
      const settle = () => {
        row.panel.removeEventListener('transitionend', settle);
        if (!('open' in row.panel.dataset)) row.panel.hidden = true;
      };
      row.panel.addEventListener('transitionend', settle);
      window.setTimeout(settle, 400);
    };

    const open = (row) => {
      row.panel.hidden = false;
      // Flush the 0fr state so the opening transition has somewhere to start.
      void row.panel.offsetHeight;
      row.panel.dataset.open = '';
      row.btn.setAttribute('aria-expanded', 'true');
    };

    // Arms the collapsing CSS, then takes the whole list down.
    root.dataset.enhanced = '';
    for (const row of rows) {
      row.btn.setAttribute('aria-expanded', 'false');
      delete row.panel.dataset.open;
      row.panel.hidden = true;

      row.btn.addEventListener('click', () => {
        const wasOpen = isOpen(row);
        rows.filter(isOpen).forEach(close);
        if (!wasOpen) open(row);
      });
    }

    // The first row starts open. No reflow flush here, so it simply is open on
    // the first paint rather than animating into place.
    rows[0].panel.hidden = false;
    rows[0].panel.dataset.open = '';
    rows[0].btn.setAttribute('aria-expanded', 'true');
  })();
</script>
