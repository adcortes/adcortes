---
/*
 * The one route.
 *
 * MILESTONE 4B — Contact. Every approved section now has its body; the page
 * order, landmarks and section labelling are final.
 *
 * Page order is fixed at every size (visual-direction.md §Page order):
 * Header, Hero, Selected work, Earlier web projects band, About, Contact, Footer.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionShell from '../components/SectionShell.astro';
import HeroClassic from '../components/hero/HeroClassic.astro';
import HeroClean from '../components/hero/HeroClean.astro';
import HeroIllustrated from '../components/hero/HeroIllustrated.astro';
import HeroAnimatedValley from '../components/hero/HeroAnimatedValley.astro';
import ProjectEntry from '../components/work/ProjectEntry.astro';
import WebWorkGroup from '../components/work/WebWorkGroup.astro';
import AboutList from '../components/AboutList.astro';
import { projects, webWork, workSection } from '../data/work';
import { about, aboutItems } from '../data/about';
import { contact } from '../data/site';
import { mailtoHref } from '../lib/email';
import { heroVariant } from '../config/hero';
---

<BaseLayout>
  {/*
    The hero variant is chosen at build time in src/config/hero.ts. Each
    variant owns its markup and styles, using the shared copy
    (src/data/hero.ts); nothing about the hero is left here.
  */}
  {
    heroVariant === 'illustrated' ? (
      <HeroIllustrated />
    ) : heroVariant === 'animated-valley' ? (
      <HeroAnimatedValley />
    ) : heroVariant === 'clean' ? (
      <HeroClean />
    ) : (
      <HeroClassic />
    )
  }

  <SectionShell id="work" labelledBy="work-h" topRule>
    <h2 slot="label" id="work-h" class="section-heading">{workSection.heading}</h2>
    <p slot="label" class="work__intro">
      {workSection.intro}
    </p>

    <ol class="work__list">
      {projects.map((entry) => <ProjectEntry entry={entry} />)}
    </ol>
  </SectionShell>

  {/*
    The full-bleed band, a direct child of `main.container` so it can break out
    of the cap — see WebWorkGroup.astro. It stays between Selected work and
    About, which is where the page order puts it.
  */}
  <WebWorkGroup group={webWork} />

  <SectionShell id="about" labelledBy="about-h">
    <h2 slot="label" id="about-h" class="section-heading">{about.heading}</h2>

    <p class="about__lead">{about.lead}</p>
    <AboutList items={aboutItems} />
  </SectionShell>

  <SectionShell id="contact" labelledBy="contact-h" topRule closing>
    <p slot="label" class="section-label">{contact.label}</p>

    <h2 id="contact-h" class="contact-heading">{contact.heading}</h2>
    <p class="contact__body">{contact.body}</p>
    {/*
      §9 — the one button on the page. It is a link, not a <button>: it
      navigates, and the address is assembled in src/lib/email.ts so it is
      never printed on screen or in the HTML source (visual-direction.md §6).
    */}
    <p class="contact__action">
      <a class="cta" href={mailtoHref()}>
        {contact.ctaLabel} <span aria-hidden="true">→</span>
      </a>
    </p>
  </SectionShell>
</BaseLayout>

<style>
  /* §4 — Section heading: 22px, deliberately small. */
  .section-heading {
    font-size: var(--fs-section);
    font-weight: var(--fw-semibold);
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  /*
   * §4 — body small, muted: the one line under the Work heading. On mobile only
   * its first sentence shows, because the diagrams it refers to are hidden (§7).
   */
  .work__intro {
    margin-top: var(--space-10);
    font-size: var(--fs-body-small);
    line-height: 1.5;
    color: var(--text-muted);
  }

  /* The three Selected work rows. Dividers and spacing belong to each row. */
  .work__list {
    display: flex;
    flex-direction: column;
  }

  /* §4 — About lead: the one reflective paragraph. Measure 44ch. */
  .about__lead {
    max-width: 44ch;
    font-size: var(--fs-lead);
    line-height: 1.55;
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  /* Contact's label column is plain text; its h2 is the fluid closing statement. */
  .section-label {
    font-size: var(--fs-section);
    font-weight: var(--fw-semibold);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--text);
  }

  /* §4 — Contact heading, fluid. Measure 52ch on the body copy that follows. */
  .contact-heading {
    font-size: var(--fs-contact);
    font-weight: var(--fw-semibold);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  /* §4 — body, measure 52ch. */
  .contact__body {
    max-width: 52ch;
    margin-top: var(--space-20);
  }

  .contact__action {
    margin-top: var(--space-32);
  }

  /*
   * §9 primary button — the only button on the page. 48px tall, 22px side
   * padding, accent border and text, filling with accent on hover. Its focus
   * ring is the paper-200 variant already set globally in base.css §10.
   */
  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    min-height: var(--cta-height);
    padding-inline: 22px;
    border: 1px solid var(--accent);
    border-radius: var(--radius-cta);
    font-size: var(--fs-body);
    font-weight: var(--fw-semibold);
    line-height: 1;
    color: var(--accent);
    text-decoration: none;
  }

  .cta:hover {
    background: var(--accent);
    color: var(--bg);
  }
</style>
