---
/*
 * Selected collaborations — the one full-bleed light band on the page.
 * design-system.md §1, §2 (the band is the single `--paper-200` surface), §6
 * (bleeds to full width, inner content capped at 1128px).
 *
 * It sits inside `main.container`, so it breaks out with the negative-margin
 * trick: the containing block is centred, so `calc(50% - 50vw)` on each side
 * lands the edges exactly on the viewport edges. `html { overflow-x: clip }`
 * in base.css already absorbs the scrollbar overhang.
 */
import type { Collaboration } from '../types/content';

interface Props {
  heading: string;
  items: Collaboration[];
}

const { heading, items } = Astro.props;
---

<section class="collab" aria-labelledby="collab-h">
  <div class="collab__inner">
    <h2 id="collab-h" class="collab__heading">{heading}</h2>

    <ul class="collab__list">
      {
        items.map((item) => (
          <li class="collab__item">
            {
              /*
               * Both branches share `.collab__slot`, so the final logo
               * dimensions are established now and a real file drops in without
               * reflowing the band.
               *
               * The placeholder is exposed as a single image named after the
               * approved bracketed string — the same accessible name the future
               * <img alt> will carry. The visible text is `aria-hidden`, so the
               * name is announced once rather than twice.
               */
            }
            {item.logo ? (
              <img
                class="collab__slot collab__logo"
                src={item.logo.src}
                alt={item.name}
                width={item.logo.width}
                height={item.logo.height}
              />
            ) : (
              <span class="collab__slot collab__placeholder" role="img" aria-label={item.name}>
                <span aria-hidden="true">{item.name}</span>
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .collab {
    /* The one logo slot size, shared by the real images and the placeholders. */
    --collab-slot-width: clamp(112px, 13vw, 144px);
    --collab-slot-ratio: 16 / 5;

    margin-inline: calc(50% - 50vw);
    background: var(--paper-200);
    color: var(--ink-900);
    padding-block: clamp(36px, 4.5vw, 56px);
    padding-inline: var(--gutter);
  }

  /* §6 — the band bleeds, its content does not. */
  .collab__inner {
    max-width: var(--band-inner);
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-24) var(--column-gap);
  }

  /*
   * The same label/content proportions as the dark sections, but the heading
   * stays at body-small: the band is supporting evidence, not a section of its
   * own weight.
   */
  .collab__heading {
    flex: 1 1 200px;
    max-width: 280px;
    font-size: var(--fs-body-small);
    line-height: 1.4;
    color: var(--ink-900);
  }

  .collab__list {
    flex: 3.4 1 620px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-20) 0;
  }

  .collab__item {
    flex: 0 0 25%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .collab__slot {
    width: var(--collab-slot-width);
    /* Height follows from the ratio; a long wrapped name may push it taller. */
    height: auto;
    aspect-ratio: var(--collab-slot-ratio);
  }

  /* Logos vary in proportion, so they sit inside the slot rather than fill it. */
  .collab__logo {
    object-fit: contain;
  }

  /*
   * Deliberately quiet: a hairline and the name, no fill. It marks out the space
   * a logo will occupy without reading as a card. §3 — `--ink-700` is text only
   * here on the light band, where it is 7.1:1.
   */
  .collab__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: var(--space-8);
    border: var(--hairline);
    border-radius: var(--radius-chip);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.3;
    text-align: center;
    text-wrap: balance;
    color: var(--ink-700);
  }
</style>
