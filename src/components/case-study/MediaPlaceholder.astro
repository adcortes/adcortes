---
/*
 * A reserved media slot, shown only while a study is still a draft — the
 * layout decides that, not this component. It is deliberately plain and
 * explicitly labelled: the point is to review editorial rhythm before the real
 * screenshots exist, never to pass invented UI off as product interface.
 *
 * The box is sized by aspect ratio rather than a fixed height, so the drafted
 * rhythm matches what the real landscape screenshot will occupy.
 */
import type { MediaWidth } from '../../types/content';

interface Props {
  label: string;
  note: string;
  shape?: 'landscape' | 'pair';
  width?: MediaWidth;
}
const { label, note, shape = 'landscape', width = 'wide' } = Astro.props;
const frames = shape === 'pair' ? 2 : 1;
---

<div class:list={['slot', width === 'wide' && 'media-wide']}>
  <div class:list={['frames', shape]}>
    {Array.from({ length: frames }, () => <div class="frame" aria-hidden="true"></div>)}
  </div>
  <p class="meta">
    <span class="tag">Placeholder</span>
    <span>{label} — {note}</span>
  </p>
</div>

<style>
  .slot { margin-block: var(--space-56); }
  .frames { display: grid; gap: var(--space-24); }
  .frames.pair { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  /*
   * Dashed, unfilled and token-coloured: it must not read as a finished
   * surface, and it carries no mock interface of its own.
   */
  .frame {
    aspect-ratio: 16 / 9;
    border: 1px dashed var(--line-light);
    border-radius: var(--radius-frame);
  }
  .frames.pair .frame { aspect-ratio: 4 / 3; }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-8) var(--space-10);
    max-width: 64ch;
    margin-top: var(--space-16);
    color: var(--text-muted);
    font-size: var(--fs-small);
    line-height: 1.55;
  }
  .tag {
    padding: var(--space-4) var(--space-8);
    border: 1px dashed var(--line-light);
    border-radius: var(--radius-chip);
    color: var(--accent);
    font-size: var(--fs-x-small);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  @media (max-width: 959px) {
    .frames.pair { grid-template-columns: minmax(0, 1fr); gap: var(--space-32); }
    .frames.pair .frame { aspect-ratio: 16 / 10; }
  }
  @media (max-width: 639px) {
    .slot { margin-block: var(--space-40); }
  }
</style>
