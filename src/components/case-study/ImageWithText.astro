---
/*
 * A figure beside its explanation. The text keeps a narrow column and the
 * screenshot a wider one next to it, so a supporting image can sit with the
 * point it illustrates instead of interrupting the reading column.
 *
 * It extends to the left only, never to the right: the figure reaches into
 * the margin and lands on the same left edge as a full-width figure, while the
 * text column keeps the reading column's right edge. The extension is capped
 * by the room actually available beside the reading column, which is what
 * keeps it from overflowing the container at middling widths.
 *
 * Below 960px the two stack in source order, figure first.
 *
 * The frame and any crop come from the shared `.crop-frame` primitive in
 * src/styles/base.css.
 */
import type { CaseStudyFigure } from '../../types/content';

interface Props {
  text: string[];
  figure: CaseStudyFigure;
}
const { text, figure } = Astro.props;
---

<div class="with-text">
  <figure class="media">
    <div class="crop-frame" data-crop={figure.crop}>
      <img
        src={figure.src}
        alt={figure.alt}
        width={figure.width}
        height={figure.height}
        loading="lazy"
        decoding="async"
      />
    </div>
    {figure.caption && <figcaption>{figure.caption}</figcaption>}
  </figure>
  <div class="text">
    {text.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</div>

<style>
  .with-text {
    /* The widest this block gets, room permitting. */
    --cap: 940px;
    /* Half the gap between the reading column and the container's content box. */
    --room: max(0px, (min(100vw - 2 * var(--gutter), var(--band-inner)) - var(--reading)) / 2);
    /*
     * 100% is the reading column, so the block keeps its right edge and grows
     * leftwards. Measuring from 100% rather than from --reading also keeps it
     * correct once the viewport is narrower than the reading measure, where
     * the column is the viewport and there is no room to grow.
     */
    width: min(100% + var(--room), var(--cap));
    margin-left: calc(100% - min(100% + var(--room), var(--cap)));
    display: grid;
    /* A near-even split: narrative on one side, the screenshot on the other. */
    grid-template-columns: minmax(0, 9fr) minmax(0, 8fr);
    align-items: center;
    gap: var(--space-40);
    margin-block: var(--space-56);
  }
  /* Body copy, so it keeps the size and rhythm it has in the reading column. */
  .text p {
    font-size: var(--fs-body-large);
    line-height: 1.75;
  }
  .text p + p { margin-top: var(--space-20); }
  .media { margin: 0; }
  /* Matches the caption treatment in Figure.astro. */
  figcaption {
    margin-top: var(--space-12);
    color: var(--text-muted);
    font-size: var(--fs-small);
    line-height: 1.55;
  }
  @media (max-width: 959px) {
    .with-text {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-32);
    }
  }
  @media (max-width: 639px) {
    .with-text { margin-block: var(--space-40); }
  }
</style>
