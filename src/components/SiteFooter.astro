---
/*
 * Site footer.
 * content.md §Footer; design-system.md §9 (footer inline link, icon button).
 *
 * Fluid rather than capped at the container: its content sits --gutter from the
 * viewport edges at every size, so it frames the page instead of lining up with
 * the central reading column.
 *
 * The social icon links render only when their URLs exist in src/data/site.ts.
 * No `href="#"` placeholders anywhere (AGENTS.md §Constraints): a link with no
 * known destination is omitted instead. The footer is the one place the icon
 * links appear, at every width.
 */
import { footer, repo, social } from '../data/site';
import { mailtoHref } from '../lib/email';
import LinkedIn from './icons/LinkedIn.astro';
import GitHub from './icons/GitHub.astro';
import Tooltip from './Tooltip.astro';

const accessibilityMailto = mailtoHref('Accessibility barrier on the adcortes portfolio');

/*
 * Rendered only when it is set and positive, so the line reads correctly before
 * anyone has filled it in. Singular at one, plural everywhere else.
 */
const forks = repo.forks && repo.forks > 0 ? repo.forks : undefined;
const forkLabel = forks === 1 ? '1 fork' : `${forks} forks`;

const hasSocial = Boolean(social.linkedin || social.github);
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__identity">
      <p class="footer__wordmark">
        <span class="wordmark">
          adcortes<span aria-hidden="true">.</span>
        </span> © 2026
      </p>

      {/*
        The attribution line. "adcortes" goes to the profile and "GitHub" to
        this site's own repository, so each link name says where it leads; the
        separators are decorative and aria-hidden, like the wordmark's period.
      */}
      <p class="footer__attribution">
        {footer.attribution}{' '}
        {social.github ? <a href={social.github}>adcortes</a> : 'adcortes'}
        <span aria-hidden="true"> · </span>
        <a href={repo.url}>GitHub</a>
        {
          forks && (
            <>
              <span aria-hidden="true"> · </span>
              <a href={`${repo.url}/forks`}>{forkLabel}</a>
            </>
          )
        }
      </p>
    </div>

    <p class="footer__statement">
      {footer.accessibilityStatement}{' '}
      <a href={accessibilityMailto}>{footer.accessibilityLinkLabel}</a>.
    </p>

    {
      hasSocial && (
        <ul class="footer__social" aria-label="Social links">
          {social.linkedin && (
            <li>
              <a class="icon-btn" href={social.linkedin} aria-label="adcortes on LinkedIn" aria-describedby="linkedin-tooltip" data-tooltip-id="linkedin-tooltip">
                <LinkedIn />
              </a>
              <Tooltip id="linkedin-tooltip" label="LinkedIn profile" />
            </li>
          )}
          {social.github && (
            <li>
              <a class="icon-btn" href={social.github} aria-label="adcortes on GitHub" aria-describedby="github-tooltip" data-tooltip-id="github-tooltip">
                <GitHub />
              </a>
              <Tooltip id="github-tooltip" label="GitHub profile" />
            </li>
          )}
        </ul>
      )
    }
  </div>
</footer>

<style>
  .footer {
    border-top: var(--hairline);
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--text-muted);
  }

  /* §6 gutters, but no container cap — the footer runs to the viewport edges. */
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-16);
    padding-inline: var(--gutter);
    /* Leave room for the fixed back-to-top control at the end of the page. */
    padding-block: var(--space-24) calc(var(--space-32) + var(--back-to-top-size) + var(--space-16));
  }

  .footer__identity {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .footer__wordmark {
    --fs-wordmark: 16px;
  }

  .footer__statement {
    /* Inherits 14px muted; the link itself is paper-200 and underlined (§9). */
    max-width: 52ch;
  }

  /*
   * §9 — footer inline link: inherits 14px, paper-200, underlined.
   *
   * This is the one interactive target under 44px, and deliberately so: WCAG 2.2
   * SC 2.5.8 exempts a target "in a sentence or block of text", which is exactly
   * what this is. Padding it out to 44px would break the sentence it sits in.
   */
  .footer__statement a,
  .footer__attribution a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer__statement a:hover,
  .footer__attribution a:hover {
    color: var(--accent);
  }

  .footer__social {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-right: calc(var(--back-to-top-size) + var(--space-16));
  }

  /* §9 — icon button: 44 × 44, radius 6, muted, hover accent. */
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--target-min);
    height: var(--target-min);
    border-radius: var(--radius-panel);
    color: var(--text-muted);
  }

  .icon-btn:hover {
    color: var(--accent);
  }

  @media (max-width: 639px) {
    .footer__inner {
      justify-content: flex-start;
    }

    .footer__social {
      margin-right: 0;
    }
  }
</style>
