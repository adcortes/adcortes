---
/*
 * Base layout — document shell, head/meta, landmarks.
 *
 * Landmarks: header, nav[aria-label="Primary"], main#main, region "Earlier web
 * projects" (the full-bleed band), footer.
 * Keyboard order: skip link → wordmark → nav → (page content) → footer.
 */
import { site } from '../data/site';
import { theme } from '../config/theme';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BackToTop from '../components/BackToTop.astro';
import '../styles/tokens.css';
import '../styles/themes/egg.css';
import '../styles/themes/earth.css';
import '../styles/base.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;

/*
 * Absolute URLs for the canonical link and the social card, both resolved from
 * `site` in astro.config.mjs. While `site` is unset these stay undefined and
 * the tags that need them are omitted, rather than emitted against a guessed
 * origin — the same "absent rather than invented" rule the content types follow.
 */
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const ogImage = Astro.site ? new URL(site.ogImage, Astro.site) : undefined;
---

<!doctype html>
<html lang={site.lang} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical.href} />}

    {/* Fixed Earth palette favicon across all site themes. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/*
      Self-hosted Schibsted Grotesk. One variable file covers 400–900, so a
      single preload replaces separate files for each weight.
      See public/fonts/README.md.
    */}
    <link
      rel="preload"
      href="/fonts/schibsted-grotesk-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/*
      Social card. The image, its alt and og:url all depend on an absolute
      origin, so they travel together: with `site` unset none of them is
      emitted, and an og:image:alt never ships describing an absent image.
      See TODO(deploy) in astro.config.mjs.
    */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical.href} />}
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage.href} />
          <meta property="og:image:alt" content={site.ogImageAlt} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <SiteHeader />

    <main id="main" class="container">
      <slot />
    </main>

    <SiteFooter />
    <BackToTop />
  </body>
</html>
