---
/*
 * Case study layout — reusable across studies.
 *
 * A study is a header (back-link, category, H1, lead, metadata) followed by
 * chapters, each a list of editorial blocks in reading order. Chapters are not
 * uniform: a chapter carries only the blocks its story needs, so one with no
 * image renders with no media frame at all.
 *
 * Copy keeps a fixed reading measure; media may run wider (`.media-wide` in
 * src/styles/base.css) so interface detail stays legible without widening the
 * paragraphs. Reserved media slots render only while the study is a draft.
 *
 * There is no table of contents and no client script — the page is complete
 * HTML.
 */
import BaseLayout from './BaseLayout.astro';
import Figure from '../components/case-study/Figure.astro';
import Comparison from '../components/case-study/Comparison.astro';
import ImageWithText from '../components/case-study/ImageWithText.astro';
import MediaPlaceholder from '../components/case-study/MediaPlaceholder.astro';
import type { CaseStudy } from '../types/content';

interface Props { study: CaseStudy }
const { study } = Astro.props;
---

<BaseLayout
  title={`${study.title} — adcortes`}
  description={study.introduction[0]}
  draft={study.status === 'mock'}
>
  <article class="study">
    <a class="back" href="/#work"><span aria-hidden="true">←</span> Back to Selected work</a>

    <header class="intro">
      <p class="eyebrow">{study.category}</p>
      <h1>{study.title}</h1>
      {study.introduction.map((paragraph) => <p class="lead">{paragraph}</p>)}
    </header>

    <dl class="meta">
      {study.metadata.map(({ label, value }) => (
        <div>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>

    <div class="chapters">
      {study.chapters.map((chapter) => (
        <section class="chapter" id={chapter.id} aria-labelledby={`${chapter.id}-heading`}>
          <h2 id={`${chapter.id}-heading`}>
            {chapter.number && (
              <span class="number" aria-hidden="true">
                {chapter.number}
              </span>
            )}
            {chapter.heading}
          </h2>
          {chapter.blocks.map((block) => {
            switch (block.kind) {
              case 'prose':
                return block.paragraphs.map((paragraph) => <p>{paragraph}</p>);
              case 'subheading':
                return <h3>{block.text}</h3>;
              case 'image':
                return <Figure figure={block.figure} width={block.width} />;
              case 'image-text':
                return (
                  <ImageWithText text={block.text} figure={block.figure} />
                );
              case 'comparison':
                return (
                  <Comparison figures={block.figures} caption={block.caption} width={block.width} />
                );
              case 'placeholder':
                return study.status === 'mock' ? <MediaPlaceholder {...block} /> : null;
              case 'note':
                return <aside class="note">{block.text}</aside>;
            }
          })}
        </section>
      ))}
    </div>

    <nav class="closing" aria-label="Case study">
      <a class="back" href="/#work"><span aria-hidden="true">←</span> Back to Selected work</a>
      {study.nextProject && (
        <a class="back next" href={study.nextProject.href} target={study.nextProject.target}>
          {study.nextProject.label} <span aria-hidden="true">→</span>
        </a>
      )}
    </nav>
  </article>
</BaseLayout>

<style>
  /*
   * The reading column. Media blocks inside a chapter opt out of it with
   * `.media-wide`, which is why the column lives on `.study` rather than on a
   * wrapper that would clip them.
   */
  .study { width: min(100%, var(--reading)); margin-inline: auto; padding-block: var(--space-40) var(--space-104); }
  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    min-height: var(--header-link-target);
    color: var(--text-muted);
    font-size: var(--fs-body-small);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .back:hover { color: var(--accent); }

  .intro { margin-top: var(--space-40); }
  .eyebrow { color: var(--accent); font-size: var(--fs-body-small); font-weight: var(--fw-medium); }
  h1 {
    max-width: 18ch;
    margin-top: var(--space-12);
    color: var(--text-strong);
    font-size: var(--fs-display);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }
  .lead { max-width: 62ch; margin-top: var(--space-28); font-size: var(--fs-lead); line-height: 1.55; }

  .meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-20);
    margin-top: var(--space-40);
    padding-block: var(--space-20);
    border-block: var(--hairline);
  }
  .meta dt { color: var(--accent); font-size: var(--fs-small); }
  .meta dd { margin-top: var(--space-4); font-size: var(--fs-body-small); line-height: 1.5; overflow-wrap: anywhere; }

  .chapters { display: grid; gap: var(--space-80); margin-top: var(--space-80); }
  .chapter { scroll-margin-top: calc(var(--header-height) + var(--space-24)); }
  h2 {
    display: flex;
    gap: var(--space-12);
    align-items: baseline;
    color: var(--text-strong);
    font-size: clamp(var(--fs-project-title), 3vw, 32px);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }
  /* The accent is used only in short strings; these numerals are one. */
  .number {
    flex: none;
    color: var(--accent);
    font-weight: var(--fw-medium);
  }
  h3 {
    margin-top: var(--space-40);
    color: var(--text-strong);
    font-size: var(--fs-sub);
    line-height: 1.35;
  }
  .chapter p, .note { max-width: 64ch; font-size: var(--fs-body-large); line-height: 1.75; }
  /*
   * One rule for the gap above body copy, whatever precedes it: a heading, a
   * figure, or another paragraph. Blocks are ordered editorially, so the layout
   * cannot assume a fixed sequence.
   */
  .chapter p { margin-top: var(--space-20); }
  .note {
    margin-top: var(--space-20);
    padding-left: var(--space-20);
    border-left: 3px solid var(--line);
    color: var(--text-muted);
    font-size: var(--fs-body);
  }

  .closing {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-16) var(--space-32);
    justify-content: space-between;
    margin-top: var(--space-80);
    padding-top: var(--space-24);
    border-top: var(--hairline);
  }
  .next { margin-left: auto; }

  @media (max-width: 639px) {
    .study { padding-block: var(--space-24) var(--space-80); }
    .intro { margin-top: var(--space-24); }
    .chapters { gap: var(--space-64); margin-top: var(--space-64); }
    .closing { gap: 0; }
    .next { margin-left: 0; }
  }
</style>
