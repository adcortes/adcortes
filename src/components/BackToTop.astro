---
import Tooltip from './Tooltip.astro';
---

<button class="back-to-top" type="button" aria-label="Back to top" aria-describedby="back-to-top-tooltip" data-tooltip-id="back-to-top-tooltip" inert>
  <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none">
    <path d="M12 19V5m0 0-6 6m6-6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</button>
<Tooltip id="back-to-top-tooltip" label="Back to top" />

<script>
  const button = document.querySelector<HTMLButtonElement>('.back-to-top');

  if (button) {
    const updateVisibility = () => {
      const visible = window.scrollY > 450;
      if (visible === button.classList.contains('back-to-top--visible')) return;
      button.classList.toggle('back-to-top--visible', visible);
      button.inert = !visible;
    };

    updateVisibility();
    window.addEventListener('scroll', updateVisibility, { passive: true });

    button.addEventListener('click', () => {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
    });
  }
</script>

<style>
  .back-to-top {
    position: fixed;
    z-index: 10;
    right: var(--gutter);
    bottom: calc(var(--space-24) + env(safe-area-inset-bottom));
    display: grid;
    place-items: center;
    width: var(--back-to-top-size);
    height: var(--back-to-top-size);
    padding: 0;
    border: 1px solid var(--text-muted);
    border-radius: var(--radius-panel);
    background: var(--bg);
    color: var(--text);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(var(--space-8));
    transition: opacity 180ms ease, transform 180ms ease, visibility 180ms;
  }

  .back-to-top--visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .back-to-top:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
      transform: none;
    }
  }
</style>
