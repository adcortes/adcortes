---
/*
 * Site header — wordmark + primary nav.
 * design-system.md §4 (wordmark), §9 (nav link); content.md §Header.
 *
 * Three inline text links at every size: no pills, no hamburger.
 *
 * Fluid rather than capped at the container: the wordmark and nav sit --gutter
 * from the viewport edges at every size, framing the page rather than lining up
 * with the central reading column.
 */
import { nav } from '../data/site';
const isHome = Astro.url.pathname === '/';
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__logo" href="/" aria-label="adcortes, home">
      <span class="wordmark">
        adcortes<span aria-hidden="true">.</span>
      </span>
    </a>

    <nav aria-label="Primary">
      <ul class="nav">
        {
          nav.map((item) => (
            <li>
              <a class="nav__link" href={isHome ? item.href : `/${item.href}`}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');

  if (header) {
    const updateCompactState = () => {
      const compact = window.scrollY > 80;
      if (compact !== header.classList.contains('site-header--compact')) {
        header.classList.toggle('site-header--compact', compact);
      }
    };

    updateCompactState();
    window.addEventListener('scroll', updateCompactState, { passive: true });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* The flow height stays constant while the visible bar gets shorter. */
    height: var(--header-height);
    pointer-events: none;
  }

  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: var(--header-height);
    border-bottom: var(--hairline);
    background: var(--bg);
    transition: height 200ms ease;
  }

  /* §6 gutters, but no container cap — the header runs to the viewport edges. */
  .site-header__inner {
    position: relative;
    max-width: var(--container);
    margin-inline: auto;
    display: flex;
    padding-inline: var(--gutter);
    justify-content: space-between;
    align-items: center;
    gap: var(--space-16);
    min-height: var(--header-height);
    pointer-events: auto;
    transition: min-height 200ms ease;
  }

  .site-header--compact::before {
    height: var(--header-compact-height);
  }

  .site-header--compact .site-header__inner {
    min-height: var(--header-compact-height);
  }
  .site-header--compact .wordmark {
    font-size: var(--fs-wordmark-compact);
  }

  .site-header__logo {
    /* §3 — 44px minimum target. */
    min-height: var(--header-link-target);
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--nav-gap);
  }

  /* §9 — 15px/500, 44px row, hover to accent. */
  .nav__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--header-link-target);
    font-size: var(--fs-nav);
    font-weight: var(--fw-medium);
    line-height: 1;
    color: var(--text);
    text-decoration: none;
  }

  .nav__link:hover {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header::before,
    .site-header__inner {
      transition: none;
    }
  }
</style>
