---
/*
 * The same flow or component across different products, shown side by side.
 * Each image keeps its own alt text and its own label; the shared caption
 * explains what the comparison shows. Below 960px the images stack, so a
 * two-up pair never shrinks past the point where its interface detail is
 * readable.
 *
 * A pair reads better compact than at the full media width, so the container
 * caps itself at --media-cap rather than running out to the container edge the
 * way a single screenshot does.
 *
 * The frame and any close-up crop come from the shared `.crop-frame`
 * primitive in src/styles/base.css.
 */
import type { CaseStudyFigure, MediaWidth } from '../../types/content';

interface Props {
  figures: CaseStudyFigure[];
  caption?: string;
  width?: MediaWidth;
}
const { figures, caption, width = 'wide' } = Astro.props;
---

<figure class:list={['comparison', width === 'wide' && 'media-wide']}>
  <div class="grid">
    {figures.map((figure) => (
      <div class="item">
        <div class="crop-frame" data-crop={figure.crop}>
          <img
            src={figure.src}
            alt={figure.alt}
            width={figure.width}
            height={figure.height}
            loading="lazy"
            decoding="async"
          />
        </div>
        {/* Per-image label, not a caption element: the <figure> owns the caption. */}
        {figure.caption && <p class="label">{figure.caption}</p>}
      </div>
    ))}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .comparison {
    /* Read by .media-wide in src/styles/base.css. */
    --media-cap: 940px;
    margin-block: var(--space-56);
  }
  /*
   * Equal columns without counting the figures, which keeps the template out
   * of an inline style the CSP would block.
   */
  .grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: var(--space-24);
  }
  .label {
    margin-top: var(--space-10);
    color: var(--text-muted);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.5;
  }
  figcaption {
    max-width: 64ch;
    margin-top: var(--space-16);
    color: var(--text-muted);
    font-size: var(--fs-small);
    line-height: 1.55;
  }
  @media (max-width: 959px) {
    .grid { grid-auto-flow: row; gap: var(--space-32); }
  }
  @media (max-width: 639px) {
    .comparison { margin-block: var(--space-40); }
  }
</style>
