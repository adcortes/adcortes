---
/*
 * Airline design-system diagram — the "Tokens → Components → Products" ladder.
 * Reference: handoff/previews (visual reference only) + assets.md ("Project
 * diagram (Airline DS)"); labels from content.md §Selected work, project 2.
 *
 * Three rows, each a label beside the thing it names, joined by a short vertical
 * connector so the ladder reads downward. The whole drawing is aria-hidden — the
 * <figcaption> rendered by ProjectEntry carries the meaning — so the three row
 * labels are part of the picture, not accessible text. Rebuilt from the
 * documented tokens; no prototype markup, CSS or script is reproduced here.
 *
 * One grid holds every row, so the label column is as wide as its longest label
 * at any size and the connectors line up with the column they descend into.
 */
---

<div class="ladder" aria-hidden="true">
  <span class="ladder__label">Tokens</span>
  <span class="ladder__swatches">
    <span class="ladder__swatch ladder__swatch--accent"></span>
    <span class="ladder__swatch ladder__swatch--accent-outline"></span>
    <span class="ladder__swatch ladder__swatch--layer"></span>
    <span class="ladder__swatch ladder__swatch--layer-outline"></span>
    <span class="ladder__swatch ladder__swatch--paper"></span>
  </span>

  <span class="ladder__connector"></span>

  <span class="ladder__label">Components</span>
  <span class="ladder__parts">
    <span class="ladder__part"></span>
    <span class="ladder__part ladder__part--selected"></span>
    <span class="ladder__part"></span>
  </span>

  <span class="ladder__connector"></span>

  <span class="ladder__label">Products</span>
  <span class="ladder__products">
    <span class="ladder__product">Booking</span>
    <span class="ladder__product">Disruption</span>
  </span>
</div>

<style>
  /* §8 — 10px diagram frame, 4px diagram chips. Same 220px floor and fluid
     padding as the other diagram, so the two sit at the same scale. */
  .ladder {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-content: center;
    align-items: center;
    gap: clamp(10px, 1.6vw, 14px) var(--space-12);
    min-height: 220px;
    padding: clamp(14px, 2.2vw, 22px);
    border: var(--hairline);
    border-radius: var(--radius-frame);
  }

  /* §4 — smallest documented size, muted. The prototype's 13px is not on the
     type scale, so these sit at 14px. */
  .ladder__label {
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--paper-400);
  }

  /* The spine between rows, descending into the column it connects. */
  .ladder__connector {
    grid-column: 2;
    width: 1px;
    height: 14px;
    background: var(--ink-500);
  }

  .ladder__swatches,
  .ladder__parts,
  .ladder__products {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8);
  }

  /* Tokens: five small discs, filled and outlined. */
  .ladder__swatch {
    width: 16px;
    height: 16px;
    border-radius: 50%;
  }

  .ladder__swatch--accent {
    background: var(--accent);
  }

  .ladder__swatch--accent-outline {
    border: 1px solid var(--accent);
  }

  .ladder__swatch--layer {
    background: var(--ink-500);
  }

  .ladder__swatch--layer-outline {
    border: 1px solid var(--ink-500);
  }

  .ladder__swatch--paper {
    background: var(--paper-200);
  }

  /* Components: three outlined blanks; one is the selected state. */
  .ladder__part {
    width: 40px;
    height: 20px;
    border: 1px solid var(--ink-500);
    border-radius: var(--radius-chip);
  }

  .ladder__part--selected {
    border-color: var(--accent);
  }

  /* Products: the only named chips in the ladder. */
  .ladder__product {
    padding: 3px 10px;
    border: 1px solid var(--ink-500);
    border-radius: var(--radius-chip);
    font-size: var(--fs-small);
    line-height: 1.4;
  }
</style>
