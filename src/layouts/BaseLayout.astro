---
/*
 * Base layout — document shell, head/meta, landmarks.
 * content.md §Meta, §Utility; visual-direction.md §1, §5, §7.
 *
 * Landmarks: header, nav[aria-label="Primary"], main#main, region "Earlier web
 * projects" (the full-bleed band), footer.
 * Keyboard order: skip link → wordmark → nav → (page content) → footer.
 */
import { site } from '../data/site';
import { theme } from '../config/theme';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/tokens.css';
import '../styles/themes/egg.css';
import '../styles/themes/earth.css';
import '../styles/base.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
---

<!doctype html>
<html lang={site.lang} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    {/*
      assets.md — favicons served from the active theme's own folder under
      public/themes/, except favicon.ico: a legacy fallback that is not
      recolored per theme (see color-adjustments.md's asset list), so it
      stays shared at the site root.
    */}
    <link rel="icon" href={`/themes/${theme}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href={`/themes/${theme}/apple-touch-icon.png`} />

    {/*
      Self-hosted Schibsted Grotesk. One variable file covers 400/500/600, so a
      single preload replaces the three the handoff anticipated.
      See public/fonts/README.md.
    */}
    <link
      rel="preload"
      href="/fonts/schibsted-grotesk-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/*
      Social card. og:image:alt and the card type are set here; the absolute
      og:image URL and <link rel="canonical"> are deliberately absent until
      Cloudflare Pages is configured — see TODO(deploy) in astro.config.mjs.
    */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image:alt" content={site.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <SiteHeader />

    <main id="main" class="container">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
