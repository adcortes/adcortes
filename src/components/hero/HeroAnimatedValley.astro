---
import { readFileSync } from 'node:fs';
import { hero } from '../../data/hero';

// The source SVGs contain one compound path each. In the forest files, each
// closed subpath is a tree except the last one, which is the ground. Splitting
// selected subpaths at build time preserves the exact drawing and source assets.
const files = [
  'hero-valley-1-ridge-far.svg',
  'hero-valley-2-ridge-mid.svg',
  'hero-valley-3-forest-back.svg',
  'hero-valley-4-forest-mid.svg',
  'hero-valley-5-forest-front.svg',
] as const;

const windTrees: Record<number, readonly number[]> = {
  3: [15, 34, 58, 78, 105],
  4: [8, 28, 50, 70, 88],
};

const titleBreak = ' to interface.';
const titleFirstLine = hero.title.endsWith(titleBreak)
  ? hero.title.slice(0, -titleBreak.length)
  : hero.title;
const titleSecondLine = hero.title.endsWith(titleBreak) ? titleBreak.trimStart() : '';

const layers = files.map((file, layerIndex) => {
  const source = readFileSync(new URL(`../../../public/themes/earth/hero-valley-layers/${file}`, import.meta.url), 'utf8');
  const path = source.match(/<path\s+d="([^"]+)"\s+fill="([^"]+)"/);
  if (!path) throw new Error(`Invalid valley layer: ${file}`);

  const [, drawing, fill] = path;
  const selected = new Set(windTrees[layerIndex] ?? []);
  const subpaths = drawing.match(/M[^Z]*Z/g);
  if (!subpaths || subpaths.join('') !== drawing.replace(/\s+(?=M)/g, '') || (selected.size && Math.max(...selected) >= subpaths.length - 1)) {
    throw new Error(`Unexpected valley path structure: ${file}`);
  }

  let staticPath = '';
  const shapes: string[] = [];
  const flush = () => {
    if (staticPath) shapes.push(`<path d="${staticPath}" fill="${fill}"/>`);
    staticPath = '';
  };

  subpaths.forEach((shape, index) => {
    if (selected.has(index)) {
      flush();
      shapes.push(`<path d="${shape}" fill="${fill}" data-wind="${layerIndex}-${index}"/>`);
    } else {
      staticPath += shape;
    }
  });
  flush();

  // The two mask rectangles use the SVG's 1600 × 620 coordinates. One is
  // fully opaque; the other adds a short alpha feather to the reveal edge.
  // They are dormant unless JavaScript attaches the mask during the entrance.
  const maskId = `valley-reveal-${layerIndex}`;
  const featherId = `valley-feather-${layerIndex}`;
  const markup = layerIndex === 0
    ? shapes.join('')
    : `<defs><linearGradient id="${featherId}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-opacity="1"/><stop offset="1" stop-opacity="0"/></linearGradient><mask id="${maskId}" maskUnits="userSpaceOnUse" maskContentUnits="userSpaceOnUse" mask-type="alpha" x="0" y="0" width="1600" height="620"><rect data-valley-solid x="0" y="0" width="1600" height="620" fill="currentColor"/><rect data-valley-feather x="0" y="620" width="1600" height="72" fill="url(#${featherId})"/></mask></defs><g data-valley-drawing>${shapes.join('')}</g>`;

  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 620" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">${markup}</svg>`;
});
---

<section class="hero" aria-labelledby="hero-h" data-animated-valley>
  <div class="hero__landscape" aria-hidden="true">
    {layers.map((svg, index) => (
      <div class="hero__layer" data-valley-layer>
        <div class="hero__parallax" data-valley-parallax={index < 2 ? index : undefined} set:html={svg} />
      </div>
    ))}
  </div>

  <div class="hero__content">
    <p class="hero__eyebrow" data-valley-text>{hero.eyebrow}</p>
    <h1 id="hero-h" class="hero__title" data-valley-text>
      {titleFirstLine} {titleSecondLine}
    </h1>
    <p class="hero__subline" data-valley-text>{hero.subline.illustrated}</p>
    <p class="hero__intro" data-valley-text>{hero.intro}</p>
    <p class="hero__jump" data-valley-text>
      <a class="hero__link" href={hero.jumpHref}>
        {hero.jumpLabel} <span aria-hidden="true">↓</span>
      </a>
    </p>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { motion } from '../../lib/motion';

  const hero = document.querySelector<HTMLElement>('[data-animated-valley]');
  if (hero) {
    const valley = motion.hero.valley;
    const root = document.documentElement;
    const layers = Array.from(hero.querySelectorAll<HTMLElement>('[data-valley-layer]'));
    const text = Array.from(hero.querySelectorAll<HTMLElement>('[data-valley-text]'));
    const drawings = Array.from(hero.querySelectorAll<SVGGElement>('[data-valley-drawing]'));
    const solids = Array.from(hero.querySelectorAll<SVGRectElement>('[data-valley-solid]'));
    const feathers = Array.from(hero.querySelectorAll<SVGRectElement>('[data-valley-feather]'));
    const frontTrees = Array.from(hero.querySelectorAll<SVGPathElement>('[data-wind^="4-"]'));
    let entranceHandled = false;
    let ambientStarted = false;
    const ambientMedia = gsap.matchMedia();

    const resetEntrance = () => {
      delete root.dataset.heroMotion;
      drawings.forEach((drawing) => drawing.removeAttribute('mask'));
      solids.forEach((rect) => rect.setAttribute('height', '620'));
      feathers.forEach((rect) => rect.setAttribute('y', '620'));
      gsap.set([...layers, ...text, ...frontTrees], { clearProps: 'opacity,transform' });
    };

    const startAmbient = () => {
      if (ambientStarted) return;
      ambientStarted = true;
      ambientMedia.add('(min-width: 1024px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)', () => {
        const ridges = Array.from(hero.querySelectorAll<HTMLElement>('[data-valley-parallax]'));
        const move = ridges.map((ridge) => gsap.quickTo(ridge, 'x', {
          duration: valley.parallaxDuration,
          ease: motion.pointerEase,
        }));
        const onMove = (event: PointerEvent) => {
          const bounds = hero.getBoundingClientRect();
          const position = (event.clientX - bounds.left) / bounds.width - 0.5;
          move.forEach((setX, index) => setX(position * 2 * valley.parallax[index]));
        };
        const onLeave = () => move.forEach((setX) => setX(0));
        hero.addEventListener('pointermove', onMove, { passive: true });
        hero.addEventListener('pointerleave', onLeave);

        const trees = hero.querySelectorAll<SVGPathElement>('[data-wind]');
        trees.forEach((tree, index) => {
          gsap.to(tree, {
            rotation: valley.windDegrees[index % valley.windDegrees.length] * (index % 2 ? -1 : 1),
            duration: valley.windDuration[index % valley.windDuration.length],
            delay: index * 0.17,
            ease: motion.windEase,
            yoyo: true,
            repeat: -1,
          });
        });

        return () => {
          hero.removeEventListener('pointermove', onMove);
          hero.removeEventListener('pointerleave', onLeave);
          gsap.killTweensOf(ridges);
          gsap.set(ridges, { clearProps: 'transform' });
        };
      });
    };

    const media = gsap.matchMedia();
    media.add('(prefers-reduced-motion: no-preference)', () => {
      if (entranceHandled) {
        startAmbient();
        return;
      }
      entranceHandled = true;
      if (root.dataset.heroMotion !== 'ready' || hero.getBoundingClientRect().bottom <= 0) {
        resetEntrance();
        startAmbient();
        return;
      }

      drawings.forEach((drawing, index) => drawing.setAttribute('mask', `url(#valley-reveal-${index + 1})`));
      const timeline = gsap.timeline({ defaults: { ease: motion.ease } });
      const revealLayer = (layerIndex: number, settings: { start: number; duration: number; fade: number; ease: string }) => {
        const solid = solids[layerIndex - 1];
        const feather = feathers[layerIndex - 1];
        timeline
          .fromTo(solid, { attr: { height: 0 } }, {
            attr: { height: 620 },
            duration: settings.duration,
            ease: settings.ease,
          }, settings.start)
          .fromTo(feather, { attr: { y: 0 } }, {
            attr: { y: 620 },
            duration: settings.duration,
            ease: settings.ease,
          }, settings.start)
          .fromTo(layers[layerIndex], { opacity: 0 }, {
            opacity: 1,
            duration: settings.fade,
            ease: 'sine.out',
          }, settings.start);
      };

      timeline.fromTo(layers[0], { opacity: 0, scale: valley.distant.scale }, {
        opacity: 1,
        scale: 1,
        transformOrigin: '50% 100%',
        duration: valley.distant.duration,
        ease: valley.distant.ease,
      }, valley.distant.start);
      revealLayer(1, valley.middle);
      revealLayer(2, valley.forestBack);
      revealLayer(3, valley.forestMiddle);
      revealLayer(4, valley.forestFront);
      timeline.fromTo(frontTrees, { opacity: 0 }, {
        opacity: 1,
        duration: valley.forestFront.treeDuration,
        stagger: valley.forestFront.treeStagger,
        ease: 'sine.out',
      }, valley.forestFront.treeStart);

      const addText = (index: number, settings: { start: number; duration: number }, ease: string) => {
        timeline.fromTo(text[index], { opacity: 0, y: valley.text.y }, {
          opacity: 1,
          y: 0,
          duration: settings.duration,
          ease,
        }, settings.start);
      };
      addText(0, valley.text.eyebrow, 'power2.out');
      addText(1, valley.text.title, motion.ease);
      addText(2, valley.text.subline, motion.ease);
      addText(3, valley.text.intro, 'power2.out');
      addText(4, valley.text.action, 'power2.out');

      let finished = false;
      let fallback = 0;
      const finish = () => {
        if (finished) return;
        finished = true;
        window.clearTimeout(fallback);
        resetEntrance();
        startAmbient();
      };
      timeline.eventCallback('onComplete', finish);
      // Covers a stalled timeline while preserving the static SVG fallback.
      fallback = window.setTimeout(() => timeline.progress(1), 3000);
      const onFocusIn = () => timeline.progress(1);
      hero.addEventListener('focusin', onFocusIn, { once: true });
      return () => {
        window.clearTimeout(fallback);
        hero.removeEventListener('focusin', onFocusIn);
        timeline.kill();
        resetEntrance();
      };
    });
    document.addEventListener('astro:before-swap', () => {
      media.revert();
      ambientMedia.revert();
    }, { once: true });
  }
</script>

<style>
  :global(html[data-hero-motion='ready'] [data-valley-layer]) {
    opacity: 0;
  }

  :global(html[data-hero-motion='ready'] [data-valley-text]) {
    opacity: 0;
  }

  .hero {
    position: relative;
    isolation: isolate;
    min-height: calc(100vh - var(--header-height) - 1px);
    min-height: calc(100dvh - var(--header-height) - 1px);
    padding-block: clamp(56px, 4vw, 72px) var(--space-80);
  }

  .hero__landscape {
    position: absolute;
    inset: calc(-1 * var(--header-height) - 1px) auto 0 50%;
    width: 100vw;
    overflow: hidden;
    transform: translateX(-50%);
    pointer-events: none;
    z-index: 0;
  }

  .hero__layer,
  .hero__parallax {
    position: absolute;
    inset: 0;
  }

  /* The moving ridges need a few spare pixels at each edge. */
  .hero__parallax[data-valley-parallax] {
    inset-inline: -8px;
  }

  .hero__parallax :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
  }

  .hero__parallax :global([data-wind]) {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    width: min(100%, 90%);
    margin-top: 12vh;
  }

  .hero__eyebrow {
    color: var(--text-muted);
    font-size: var(--fs-small);
    line-height: 1.4;
  }

  .hero__title {
    margin-top: var(--space-20);
    font-size: var(--fs-valley-title);
    font-weight: var(--fw-bold);
    line-height: 1.04;
    letter-spacing: -0.02em;
  }

  .hero__title span {
    display: block;
  }

  .hero__subline {
    margin-top: clamp(20px, 1vw, 32px);
    color: var(--accent);
    font-size: var(--fs-valley-subline);
    font-weight: var(--fw-bold);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .hero__intro {
    max-width: 680px;
    margin-top: var(--space-28);
    font-size: var(--fs-body-large);
    line-height: 1.65;
  }

  .hero__jump {
    margin-top: var(--space-28);
  }

  .hero__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    min-height: var(--cta-height);
    padding-inline: var(--space-24);
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--bg);
    font-size: var(--fs-body-small);
    font-weight: var(--fw-semibold);
    line-height: 1;
    text-decoration: none;
  }

  .hero__link:hover {
    background: var(--text);
  }

  .hero__link:focus-visible {
    outline-color: var(--text);
  }

  @media (max-width: 639px) {
    .hero {
      padding-block: var(--space-56) var(--space-80);
    }

    .hero__content {
      margin-top: 0;
    }

    .hero__subline {
      max-width: 15ch;
    }
  }
</style>
