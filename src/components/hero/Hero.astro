---
import { heroMode } from '../../config/hero';
import { hero } from '../../data/hero';
---

<section class:list={['hero', { 'hero--landscape': heroMode === 'landscape' }]}>
  <div class="hero__content">
    <p class="hero__eyebrow">{hero.eyebrow}</p>
    <h1 class="hero__title">{hero.title}</h1>
    <p class="hero__subline">{hero.subline}</p>
    <p class="hero__intro">{hero.intro}</p>
    <p class="hero__jump">
      <a class="hero__link" href={hero.jumpHref}>
        {hero.jumpLabel} <span aria-hidden="true">↓</span>
      </a>
    </p>
  </div>
  {heroMode === 'landscape' && (
    <picture class="hero__art">
      <source
        media="(max-width: 959px)"
        srcset="/images/hero/hero-landscape-mobile@2x.webp"
        type="image/webp"
        width="1200"
        height="988"
      />
      <source
        srcset="/images/hero/hero-landscape@1x.webp 1x, /images/hero/hero-landscape@2x.webp 2x"
        type="image/webp"
        width="1156"
        height="644"
      />
      <img
        src="/images/hero/hero-landscape@1x.webp"
        width="1156"
        height="644"
        alt=""
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  )}
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(56px, 6vw, 80px) var(--space-104);
    padding-bottom: 0;
  }

  .hero--landscape {
    min-height: clamp(600px, calc(100vh - 88px), 760px);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    max-width: 790px;
  }

  .hero__eyebrow {
    color: var(--text-muted);
    font-size: var(--fs-body-small);
    line-height: 1.4;
  }

  .hero__title {
    margin-top: var(--space-20);
    font-size: var(--fs-hero-title);
    font-weight: var(--fw-bold);
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  .hero__subline {
    margin-top: var(--space-16);
    color: var(--accent);
    font-size: var(--fs-hero-subline);
    font-weight: var(--fw-bold);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .hero__intro {
    max-width: 510px;
    margin-top: var(--space-24);
    font-size: var(--fs-body-large);
    line-height: 1.65;
  }

  .hero__jump {
    margin-top: var(--space-28);
  }

  .hero__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    min-height: var(--cta-height);
    padding-inline: var(--space-24);
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--bg);
    font-size: var(--fs-body-small);
    font-weight: var(--fw-semibold);
    line-height: 1;
    text-decoration: none;
    transition: transform 0.18s ease;
  }

  .hero__link:hover {
    background: var(--accent-hover);
    transform: translate(1px, 1px);
  }

  .hero__link:focus-visible {
    outline-color: var(--accent-hover);
  }

  .hero__art {
    display: block;
    position: absolute;
    z-index: 0;
    width: min(76vw, 1000px);
    width: clamp(940px, 76vw, 1000px);
    right: calc((min(100vw, var(--container)) - 100vw) / 2 - var(--gutter));
    bottom: 7vh;
    pointer-events: none;
  }

  .hero__art img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 1024px) {
    .hero__art {
      bottom: 0;
    }
  }

  @media (max-width: 959px) {
    .hero--landscape {
      min-height: 0;
      padding-bottom: 0;
    }

    .hero__art {
      position: relative;
      width: 100vw;
      max-width: 100vw;
      position: relative;
      left: 50%;
      right: 50%;
      bottom: 0;
      margin-left: -50vw;
      margin-right: -50vw;
      margin-top: -6vh;
    }
  }

  @media (max-width: 639px) {
    .hero {
      padding-top: var(--space-32);
    }

    .hero__subline {
      max-width: 15ch;
    }
  }
</style>
